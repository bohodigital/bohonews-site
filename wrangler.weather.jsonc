{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bohonews-weather-edge",
  "main": "./cloudflare/weather-worker/src/index.mjs",
  "compatibility_date": "2026-08-02",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/weather/*"]
  },
  "kv_namespaces": [{ "binding": "WEATHER_CACHE" }],
  "r2_buckets": [{ "binding": "WEATHER_ASSETS" }],
  "d1_databases": [{ "binding": "WEATHER_LOCATIONS" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
