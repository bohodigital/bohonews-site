{
  "name": "bohonews-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static-first public website and publishing frontend for Boho News.",
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --test test/*.test.mjs",
    "build": "npm run content:validate && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "astro preview",
    "content:validate": "node scripts/publishing/validate-content.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "astro": "6.4.6",
    "typescript": "^5.9.3"
  }
}
