{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://bohonews.com/schemas/public-news-promotion-package.v1.schema.json",
  "title":"Boho News public promotion package v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","compilerVersion","generatedAt","site","inputHashes","inventory","articles","packageDigest"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "compilerVersion":{"type":"string"},
    "generatedAt":{"type":"string","format":"date-time"},
    "site":{"const":"https://bohonews.com"},
    "inputHashes":{"type":"object","additionalProperties":{"type":"string","pattern":"^[a-f0-9]{64}$"}},
    "inventory":{"type":"object","additionalProperties":false,"required":["articleCount","routeCount"],"properties":{"articleCount":{"type":"integer","minimum":0},"routeCount":{"type":"integer","minimum":0}}},
    "articles":{"type":"array","items":{"$ref":"#/$defs/publicArticle"}},
    "packageDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  },
  "$defs":{
    "publicArticle":{
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","id","slug","headline","dek","articleType","publicationStatus","section","topics","entities","locations","authors","editor","publishedAt","updatedAt","eventId","body","confirmedFactsSummary","uncertainty","citations","leadImage","media","revisionHistory","corrections","retractionState","distribution","social","search","relatedArticleIds","canonicalUrl","supersedesArticleId","supersededByArticleId"],
      "properties":{"schemaVersion":{"const":"1.0.0"},"id":{"type":"string"},"slug":{"type":"string"},"headline":{"type":"string"},"dek":{"type":"string"},"articleType":{"type":"string"},"publicationStatus":{"const":"approved"},"section":{"type":"string"},"topics":{"type":"array"},"entities":{"type":"array"},"locations":{"type":"array"},"authors":{"type":"array","minItems":1},"editor":{"type":"string"},"publishedAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"},"eventId":{"type":"string"},"body":{"type":"string"},"confirmedFactsSummary":{"type":"array"},"uncertainty":{"type":"array"},"citations":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","title","publisher","url","publishedAt"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"publisher":{"type":"string"},"url":{"type":"string","format":"uri"},"publishedAt":{"type":"string","format":"date-time"}}}},"leadImage":{"type":["object","null"]},"media":{"type":"array"},"revisionHistory":{"type":"array","minItems":1},"corrections":{"type":"array"},"retractionState":{"enum":["current","retracted","removed"]},"distribution":{"type":"object"},"social":{"type":"object"},"search":{"type":"object"},"relatedArticleIds":{"type":"array"},"canonicalUrl":{"type":"string","format":"uri"},"supersedesArticleId":{"type":["string","null"]},"supersededByArticleId":{"type":["string","null"]}}
    }
  }
}
