{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bohonews.com/schemas/public-news-promotion-package.v2.1.1.schema.json",
  "title": "Boho News public promotion package v2.1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "compilerVersion", "releaseState", "generatedAt", "site", "inputHashes", "inventory", "mediaRights", "releaseRecords", "articles", "packageDigest"],
  "properties": {
    "schemaVersion": {"const": "2.1.1"},
    "compilerVersion": {"type": "string", "minLength": 1},
    "releaseState": {"enum": ["candidate", "final"]},
    "generatedAt": {"type": "string", "format": "date-time"},
    "site": {"const": "https://bohonews.com"},
    "inputHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceItems", "events", "claims", "articles", "approvals", "corrections", "mediaRights", "releaseRecords", "publicationIntents"],
      "properties": {
        "sourceItems": {"$ref": "#/$defs/hash"},
        "events": {"$ref": "#/$defs/hash"},
        "claims": {"$ref": "#/$defs/hash"},
        "articles": {"$ref": "#/$defs/hash"},
        "approvals": {"$ref": "#/$defs/hash"},
        "corrections": {"$ref": "#/$defs/hash"},
        "mediaRights": {"$ref": "#/$defs/hash"},
        "releaseRecords": {"$ref": "#/$defs/hash"},
        "publicationIntents": {"$ref": "#/$defs/hash"}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["articleCount", "routeCount", "mediaCount"],
      "properties": {
        "articleCount": {"type": "integer", "minimum": 0},
        "routeCount": {"type": "integer", "minimum": 0},
        "mediaCount": {"type": "integer", "minimum": 0}
      }
    },
    "mediaRights": {"type": "array", "items": {"$ref": "#/$defs/publicMediaRights"}},
    "releaseRecords": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/legacyReleaseRecord"},
          {"$ref": "#/$defs/evidenceBackedReleaseRecord"},
          {"$ref": "#/$defs/finalizedReleaseRecord"}
        ]
      }
    },
    "articles": {"type": "array", "items": {"$ref": "#/$defs/publicArticle"}},
    "packageDigest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "publisher", "url", "publishedAt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "publishedAt": {"type": "string", "format": "date-time"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rightsId", "src", "alt", "caption", "credit", "width", "height"],
      "properties": {
        "rightsId": {"$ref": "#/$defs/id"},
        "src": {"type": "string", "pattern": "^/media/[a-zA-Z0-9._/-]+$"},
        "alt": {"type": "string"},
        "caption": {"type": "string"},
        "credit": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "role": {"enum": ["lead", "card", "square-social", "four-three", "sixteen-nine", "open-graph", "compact-mobile"]}
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "at", "summary"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "at": {"type": "string", "format": "date-time"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "publicChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "at", "summary"],
      "properties": {
        "type": {"enum": ["update", "correction", "clarification", "editors-note", "retraction", "removal", "superseded"]},
        "at": {"type": "string", "format": "date-time"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "verificationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalUrl", "immutableUrl", "status", "canonicalMarker"],
      "properties": {
        "canonicalUrl": {"type": "string", "format": "uri"},
        "immutableUrl": {"type": "string", "format": "uri"},
        "status": {"const": 200},
        "canonicalMarker": {"const": true}
      }
    },
    "legacyReleaseRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "releaseId", "deploymentProvider", "accountReference", "project", "environment", "immutableDeploymentUrl", "publicSiteCommit", "productionActivationAt", "routeVerifiedAt", "newArticleIds", "updatedArticleIds", "canonicalUrls", "verificationResults", "verifier", "recordHash"],
      "properties": {
        "schemaVersion": {"const": "2.0.0"},
        "releaseId": {"$ref": "#/$defs/id"},
        "deploymentProvider": {"const": "cloudflare-pages"},
        "accountReference": {"const": "boho-digital-services.cloudflare.primary-management"},
        "project": {"const": "bohonews"},
        "environment": {"const": "production"},
        "immutableDeploymentUrl": {"type": "string", "format": "uri"},
        "publicSiteCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "productionActivationAt": {"type": "string", "format": "date-time"},
        "routeVerifiedAt": {"type": "string", "format": "date-time"},
        "newArticleIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "updatedArticleIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "canonicalUrls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
        "verificationResults": {"type": "array", "items": {"$ref": "#/$defs/verificationResult"}},
        "verifier": {"type": "string", "minLength": 1},
        "recordHash": {"$ref": "#/$defs/hash"}
      }
    },
    "evidenceBackedReleaseRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "releaseId", "deploymentProvider", "accountReference",
        "project", "environment", "activationDeploymentUrl",
        "providerActivatedAt", "canonicalFirstPublicAt",
        "newArticleIds", "updatedArticleIds", "canonicalUrls",
        "activationEvidenceHash", "previousVerifiedDeploymentReference",
        "recordHash"
      ],
      "properties": {
        "schemaVersion": {"const": "2.1.1"},
        "releaseId": {"$ref": "#/$defs/id"},
        "deploymentProvider": {"const": "cloudflare-pages"},
        "accountReference": {"const": "boho-digital-services.cloudflare.primary-management"},
        "project": {"const": "bohonews"},
        "environment": {"const": "production"},
        "activationDeploymentUrl": {"type": "string", "format": "uri"},
        "providerActivatedAt": {"type": "string", "format": "date-time"},
        "canonicalFirstPublicAt": {"type": "string", "format": "date-time"},
        "newArticleIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "updatedArticleIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "canonicalUrls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
        "activationEvidenceHash": {"$ref": "#/$defs/hash"},
        "previousVerifiedDeploymentReference": {"type": "string", "minLength": 1},
        "recordHash": {"$ref": "#/$defs/hash"}
      }
    },
    "finalizedReleaseRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "releaseId", "deploymentProvider", "accountReference",
        "project", "environment", "activationDeploymentUrl",
        "providerActivatedAt", "canonicalFirstPublicAt",
        "newArticleIds", "updatedArticleIds", "canonicalUrls",
        "activationEvidenceHash", "canonicalObservationEvidenceHash",
        "previousVerifiedDeploymentReference", "finalImmutableUrl",
        "finalDeploymentActivatedAt", "finalRouteVerifiedAt",
        "finalPackageDigest", "publicContentInventoryDigest",
        "releaseMarkerHash", "completionEvidenceHash",
        "finalVerificationOutputHash", "recordHash"
      ],
      "properties": {
        "schemaVersion": {"const": "2.2.0"},
        "releaseId": {"$ref": "#/$defs/id"},
        "deploymentProvider": {"const": "cloudflare-pages"},
        "accountReference": {"const": "boho-digital-services.cloudflare.primary-management"},
        "project": {"const": "bohonews"},
        "environment": {"const": "production"},
        "activationDeploymentUrl": {"type": "string", "format": "uri"},
        "providerActivatedAt": {"type": "string", "format": "date-time"},
        "canonicalFirstPublicAt": {"type": "string", "format": "date-time"},
        "newArticleIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "updatedArticleIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "canonicalUrls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
        "activationEvidenceHash": {"$ref": "#/$defs/hash"},
        "canonicalObservationEvidenceHash": {"$ref": "#/$defs/hash"},
        "previousVerifiedDeploymentReference": {"type": "string", "minLength": 1},
        "finalImmutableUrl": {"type": "string", "format": "uri"},
        "finalDeploymentActivatedAt": {"type": "string", "format": "date-time"},
        "finalRouteVerifiedAt": {"type": "string", "format": "date-time"},
        "finalPackageDigest": {"$ref": "#/$defs/hash"},
        "publicContentInventoryDigest": {"$ref": "#/$defs/hash"},
        "releaseMarkerHash": {"$ref": "#/$defs/hash"},
        "completionEvidenceHash": {"$ref": "#/$defs/hash"},
        "finalVerificationOutputHash": {"$ref": "#/$defs/hash"},
        "recordHash": {"$ref": "#/$defs/hash"}
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "articleId", "type", "notice", "effectiveAt", "replacesCorrectionId", "state"],
      "properties": {
        "schemaVersion": {"const": "1.1.0"},
        "id": {"$ref": "#/$defs/id"},
        "articleId": {"$ref": "#/$defs/id"},
        "type": {"enum": ["minor-correction", "material-correction", "clarification", "editors-note", "retraction", "upstream-kill", "legal-safety-removal", "superseded-report"]},
        "notice": {"type": "string", "minLength": 1},
        "effectiveAt": {"type": "string", "format": "date-time"},
        "replacesCorrectionId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "state": {"const": "published"}
      }
    },
    "publicMediaRights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "sourceUrl", "creator", "rightsBasis", "license", "attribution", "restrictions", "retrievedAt", "originalFileHash", "derivatives", "caption", "altText", "archivalStatus", "contextNotes", "aiGenerated", "illustrationLabel"],
      "properties": {
        "schemaVersion": {"const": "1.1.0"},
        "id": {"$ref": "#/$defs/id"},
        "sourceUrl": {"type": "string", "format": "uri"},
        "creator": {"type": "string", "minLength": 1},
        "rightsBasis": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "attribution": {"type": "string", "minLength": 1},
        "restrictions": {"$ref": "#/$defs/stringArray"},
        "retrievedAt": {"type": "string", "format": "date-time"},
        "originalFileHash": {"$ref": "#/$defs/hash"},
        "derivatives": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "publicPath", "width", "height", "hash"],
            "properties": {
              "role": {"enum": ["lead", "card", "square-social", "four-three", "sixteen-nine", "open-graph", "compact-mobile"]},
              "publicPath": {"type": "string", "pattern": "^/media/[a-zA-Z0-9._/-]+$"},
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1},
              "hash": {"$ref": "#/$defs/hash"}
            }
          }
        },
        "caption": {"type": "string", "minLength": 1},
        "altText": {"type": "string", "minLength": 1},
        "archivalStatus": {"enum": ["current", "archival"]},
        "contextNotes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["misleading"],
          "properties": {"misleading": {"const": false}, "usage": {"type": "string"}}
        },
        "aiGenerated": {"const": false},
        "illustrationLabel": {"type": "null"}
      }
    },
    "publicArticle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "slug", "headline", "dek", "articleType", "publicationStatus", "section", "desk", "topics", "entities", "locations", "authors", "editor", "publishedAt", "updatedAt", "releaseId", "publicChangeLog", "eventId", "body", "bodyBlocks", "confirmedFactsSummary", "uncertainty", "citations", "leadImage", "media", "corrections", "retractionState", "distribution", "social", "search", "relatedArticleIds", "canonicalUrl", "supersedesArticleId", "supersededByArticleId"],
      "properties": {
        "schemaVersion": {"const": "2.0.0"},
        "id": {"$ref": "#/$defs/id"},
        "slug": {"$ref": "#/$defs/id"},
        "headline": {"type": "string", "minLength": 1},
        "dek": {"type": "string", "minLength": 1},
        "articleType": {"enum": ["breaking-report", "developing-story", "news-report", "live-coverage", "explainer", "analysis", "investigation", "fact-check", "opinion", "timeline", "vote-report", "court-decision", "executive-action", "campaign-finance", "document-report", "data-report"]},
        "publicationStatus": {"const": "approved"},
        "section": {"enum": ["us", "world", "politics", "business", "crime-justice", "weather-climate", "health-science", "technology", "culture", "sports", "investigations", "analysis", "opinion"]},
        "desk": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "topics": {"$ref": "#/$defs/stringArray"},
        "entities": {"$ref": "#/$defs/stringArray"},
        "locations": {"$ref": "#/$defs/stringArray"},
        "authors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "editor": {"type": "string", "minLength": 1},
        "publishedAt": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "updatedAt": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "releaseId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "publicChangeLog": {"type": "array", "items": {"$ref": "#/$defs/publicChange"}},
        "eventId": {"$ref": "#/$defs/id"},
        "body": {"type": "string"},
        "bodyBlocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bodyBlock"}},
        "confirmedFactsSummary": {"$ref": "#/$defs/stringArray"},
        "uncertainty": {"$ref": "#/$defs/stringArray"},
        "citations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/citation"}},
        "leadImage": {"anyOf": [{"$ref": "#/$defs/image"}, {"type": "null"}]},
        "media": {"type": "array", "items": {"$ref": "#/$defs/image"}},
        "corrections": {"type": "array", "items": {"$ref": "#/$defs/correction"}},
        "retractionState": {"enum": ["current", "retracted", "removed"]},
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rss", "newsSitemap"],
          "properties": {"rss": {"type": "boolean"}, "newsSitemap": {"type": "boolean"}}
        },
        "social": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1},
            "image": {"type": "string", "pattern": "^/media/[a-zA-Z0-9._/-]+$"}
          }
        },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index"],
          "properties": {
            "index": {"type": "boolean"},
            "title": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1}
          }
        },
        "relatedArticleIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "canonicalUrl": {"type": "string", "pattern": "^https://bohonews\\.com/articles/[a-z0-9]+(?:-[a-z0-9]+)*/$"},
        "supersedesArticleId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "supersededByArticleId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "bodyBlock": {
      "oneOf": [
        {"type":"object","additionalProperties":false,"required":["type","text"],"properties":{"type":{"const":"paragraph"},"text":{"type":"string","minLength":1}}},
        {"type":"object","additionalProperties":false,"required":["type","text","level"],"properties":{"type":{"const":"subheading"},"text":{"type":"string","minLength":1},"level":{"enum":[2,3]}}},
        {"type":"object","additionalProperties":false,"required":["type","items"],"properties":{"type":{"enum":["ordered-list","unordered-list"]},"items":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}}},
        {"type":"object","additionalProperties":false,"required":["type","rightsId","src","alt","caption","credit","width","height"],"properties":{"type":{"enum":["media","official-document-render"]},"rightsId":{"$ref":"#/$defs/id"},"src":{"type":"string","pattern":"^/media/[a-zA-Z0-9._/-]+$"},"alt":{"type":"string"},"caption":{"type":"string"},"credit":{"type":"string","minLength":1},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1},"sourceUrl":{"type":"string","format":"uri"}}},
        {"type":"object","additionalProperties":false,"required":["type","caption","columns","rows"],"properties":{"type":{"const":"table"},"caption":{"type":"string","minLength":1},"columns":{"type":"array","minItems":2,"items":{"type":"string","minLength":1}},"rows":{"type":"array","minItems":1,"items":{"type":"array","items":{"type":"string"}}}}},
        {"type":"object","additionalProperties":false,"required":["type","title","text","sourceId"],"properties":{"type":{"const":"source-callout"},"title":{"type":"string","minLength":1},"text":{"type":"string","minLength":1},"sourceId":{"$ref":"#/$defs/id"}}},
        {"type":"object","additionalProperties":false,"required":["type","articleId"],"properties":{"type":{"const":"related-story"},"articleId":{"$ref":"#/$defs/id"}}}
      ]
    }
  }
}
