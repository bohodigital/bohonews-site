---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { candidatePreviewEnabled } from "../../../../lib/news";

const federalSources = [
  {
    id: "e0014",
    label: "E0014",
    title: "Federal grand-jury subpoena to Interlochen",
    detail: "Four-page Feb. 6, 2020 subpoena seeking records concerning Epstein and Maxwell donations, tuition or other payments, and visits.",
    href: "/evidence/interlochen/e0014-grand-jury-subpoena.pdf",
    hash: "9048c68e505c845e91cc623f52740e263f984311b78b4b16e131e1e2753d5945"
  },
  {
    id: "e0020",
    label: "E0020",
    title: "Grand-jury exhibit bundle EFTA00008716",
    detail: "Includes 1994 donor correspondence, flight-log exhibits, Maxwell correspondence, and a redacted student application.",
    href: "/evidence/interlochen/e0020-grand-jury-exhibit-bundle.pdf",
    hash: "6cb4fa1c9774def2aa8e8d01db1f5cf3872574e531287f566e035ab76fe800a2"
  },
  {
    id: "e0023",
    label: "E0023",
    title: "United States v. Maxwell trial transcript, Day 2",
    detail: "Includes sworn testimony concerning meeting Epstein and Maxwell at Interlochen.",
    href: "/evidence/interlochen/e0023-maxwell-day-2-interlochen-excerpt.pdf",
    hash: "7611a1a82cdead0a7ad4574f6e53875c438e5bdd380a5fb693f7700911226f71",
    excerptHash: "2b013ca4f69c17240d28336a1b0170b59e7e5f6cbedb5b58ecbb5812fa5f11e4"
  },
  {
    id: "e0024",
    label: "E0024",
    title: "United States v. Maxwell trial transcript, Day 3",
    detail: "Includes sworn testimony from Interlochen finance official Daniel Besselsen about donor correspondence and institutional records.",
    href: "/evidence/interlochen/e0024-maxwell-day-3-interlochen-excerpt.pdf",
    hash: "4b12f3c01eefb5684bffffae3ef853269d7e6a1ec1a9abd953cd183a92ce5ef8",
    excerptHash: "dbd84ceb2ff70b20a4ce925e8755e46a435da6849c5f11bb1ad11277dae50360"
  },
  {
    id: "e0026",
    label: "E0026",
    title: "United States v. Maxwell trial transcript, Day 8",
    detail: "Includes sworn pilot testimony concerning repeated Traverse City flights and visits to Interlochen.",
    href: "/evidence/interlochen/e0026-maxwell-day-8-interlochen-excerpt.pdf",
    hash: "00cc9e269bc093cbc1783c757f9f789147c4f680a280a3d5b9cb8ec97418d03a",
    excerptHash: "23594a5de0ba87389db524fe17f440ac5b043f22e4fac8504fda620830b6b7ea"
  }
];
---

<BaseLayout
  title="Interlochen Evidence Room — Boho News"
  description="Primary documents, provenance, hashes, and source classifications supporting The Interlochen Investigation."
  canonical="https://bohonews.com/investigations/interlochen/evidence/"
  noindex={candidatePreviewEnabled}
>
  <article class="evidence-room" data-pagefind-body>
    {candidatePreviewEnabled &&
      <aside class="fixture-banner" role="status">Private preview — not published</aside>}
    <header>
      <p class="eyebrow"><a href="/evidence/">Evidence Library</a> · <a href="/investigations/interlochen/">The Interlochen Investigation</a></p>
      <h1>Evidence Room</h1>
      <p>
        These records support Articles 1 and 2. A document’s presence here does not
        mean every assertion inside it is established as fact.
      </p>
      <aside class="notice content-warning">
        <strong>Content warning</strong>
        <p>Some court-record excerpts contain testimony concerning sexual abuse involving a minor.</p>
      </aside>
    </header>

    <section class="evidence-primary" id="s1">
      <p class="evidence-id">S1 · Controlling report</p>
      <h2>Investigation Report: External Investigation of Historical Abuse</h2>
      <p>
        Sanghavi Law Office / Interlochen Center for the Arts, dated July 27,
        2026. The 97-page report records accounts and institutional-file
        summaries; it expressly does not adjudicate every reported event.
      </p>
      <p><a class="button" href="/evidence/interlochen/sanghavi-report.pdf">Read the preserved report</a></p>
      <dl>
        <div><dt>Evidence ID</dt><dd>BN-INV-2026-001-E0001</dd></div>
        <div><dt>Retrieved</dt><dd>July 30, 2026, 20:34:49 UTC</dd></div>
        <div><dt>SHA-256</dt><dd><code>cf2181690504284485ffaf80ce98b9e63534191be5be00b8d89cde206d5e9825</code></dd></div>
      </dl>
    </section>

    <section aria-labelledby="part-two-source-boundary-title">
      <h2 id="part-two-source-boundary-title">Part 2 source and rights boundary</h2>
      <p>
        Part 2 cites 22 source families. Its article source register links to
        the lawful external custodian for copyrighted, repository-controlled,
        or mutable material. Internal fact-checking copies are not exposed
        merely because they were supplied to the newsroom.
      </p>
      <div class="evidence-list">
        <article>
          <p class="evidence-id">S17 · Official legal source</p>
          <h3>Michigan Register 1984-5</h3>
          <p>
            The cited pages state rules for covered children’s-camp licensees.
            They do not establish whether a particular Interlochen program was
            covered, licensed, compliant, or in violation.
          </p>
          <p><a href="https://cdm16110.contentdm.oclc.org/digital/collection/p16110coll2/id/147112/" rel="noopener noreferrer">Open the Library of Michigan record</a></p>
        </article>
        <article>
          <p class="evidence-id">S20 · Newsroom methodology</p>
          <h3>Public-record search audit</h3>
          <p>
            The public summary records the 33 index PDFs reviewed, 106
            actionable locators, zero underlying pages acquired in that phase,
            and the known index gaps.
          </p>
          <p><a href="/investigations/interlochen/methodology/#part-2-public-record-search">Read the bounded methodology</a></p>
        </article>
        <article id="part-2-correspondence-status">
          <p class="evidence-id">S22 · Withheld pending verification</p>
          <h3>Part 2 institutional correspondence</h3>
          <p>
            No correspondence artifact is exposed in this candidate. The
            handoff did not include original sent or received message bytes,
            full headers, timestamps, Message-IDs, or attachment hashes.
            Building a public correspondence item remains blocked until those
            records are preserved and checked against the article.
          </p>
        </article>
      </div>
    </section>

    <section aria-labelledby="institutional-sources-title">
      <h2 id="institutional-sources-title">Institutional statements cited in Article 1</h2>
      <div class="evidence-list">
        <article id="s2">
          <p class="evidence-id">S2 · Institutional response and FAQ</p>
          <h3>External Investigation</h3>
          <p>Interlochen’s investigation hub, including its statement, FAQ, named respondents, announced actions, reporting resources and safety claims.</p>
          <p><a href="https://www.interlochen.org/about/historical-investigation" rel="noopener noreferrer">Read the original source</a></p>
        </article>
        <article id="s3">
          <p class="evidence-id">S3 · Institutional statement</p>
          <h3>A statement from Interlochen Center for the Arts</h3>
          <p>Interlochen’s account of Epstein’s attendance, donor period, internal reviews and reports from two alumni.</p>
          <p><a href="https://www.interlochen.org/statement-interlochen" rel="noopener noreferrer">Read the original source</a></p>
        </article>
      </div>
    </section>

    <section aria-labelledby="federal-records-title">
      <h2 id="federal-records-title">Federal records used in Article 1</h2>
      <div class="evidence-list">
        {federalSources.map((source) =>
          <article id={source.id}>
            <p class="evidence-id">{source.label} · Primary court record</p>
            <h3>{source.title}</h3>
            <p>{source.detail}</p>
            {source.href && <p><a href={source.href}>{source.excerptHash ? "Read the cited excerpt" : "Read the preserved record"}</a></p>}
            <p class="hash"><strong>{source.excerptHash ? "Original SHA-256" : "SHA-256"}</strong> <code>{source.hash}</code></p>
            {source.excerptHash && <p class="hash"><strong>Excerpt SHA-256</strong> <code>{source.excerptHash}</code></p>}
          </article>)}
      </div>
    </section>

    <section class="evidence-note">
      <h2>What is not exposed here</h2>
      <p>
        Boho News does not publish anonymous-survivor metadata, private contact
        notes, internal identifiers, or contextual clues removed by the
        controlling report.
      </p>
      <p>
        Part 2’s internal copies of LIFE, newspaper, publisher, university,
        repository, and archival material remain outside public routes unless
        a separate rights review authorizes republication.
      </p>
      <p><a href="/investigations/interlochen/methodology/">Read the methodology →</a></p>
    </section>
  </article>
</BaseLayout>
