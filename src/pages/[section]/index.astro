---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsVisual from "../../components/NewsVisual.astro";
import StoryCard from "../../components/StoryCard.astro";
import { contextualNavigation, fixturesEnabled, sectionArticles, sections } from "../../lib/news";

export const getStaticPaths = (() => {
  return sections.map(([section, label]) => ({
    params: { section },
    props: { label }
  }));
}) satisfies GetStaticPaths;

const { label } = Astro.props;
const list = sectionArticles(Astro.params.section!);
const contextLinks = contextualNavigation[Astro.params.section!] ?? [];
const variant = Astro.params.section === "weather-climate" ? "weather" :
  Astro.params.section === "crime-justice" ? "justice" :
  Astro.params.section === "business" ? "business" :
  Astro.params.section === "health-science" || Astro.params.section === "technology" ? "science" :
  Astro.params.section === "culture" || Astro.params.section === "sports" ? "culture" : "world";
---

<BaseLayout
  title={`${label} — Boho News`}
  description={`${label} articles published by Boho News.`}
  noindex={fixturesEnabled}
>
  {fixturesEnabled && <aside class="fixture-banner">Non-production fixture preview</aside>}
  <header class="index-header"><p class="eyebrow">Section</p><h1>{label}</h1></header>
  {contextLinks.length > 0 && <nav class="context-nav" aria-label={`${label} desks`}>
    {contextLinks.map(([text,href]) => <a href={href}>{text}</a>)}
  </nav>}
  {list.length ? <section class="section-story-grid">{list.map((article,index) => <StoryCard article={article} prominent={index === 0} />)}</section> :
    <section class="section-empty">
      {fixturesEnabled && <NewsVisual variant={variant} label={`${label} section visual preview`} />}
      <div><p class="eyebrow">Coverage desk</p><h2>No approved {label.toLowerCase()} coverage yet.</h2>
      <p>This section shell will populate from governed public article packages.</p></div>
    </section>}
</BaseLayout>
