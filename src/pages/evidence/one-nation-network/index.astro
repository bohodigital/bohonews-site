---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import InvestigationBibliography from "../../../components/InvestigationBibliography.astro";
import release from "../../../lib/one-nation-evidence-release.json";
import corpus from "../../../lib/one-nation-frozen-corpus-release.json";
import {oneNationBibliography} from "../../../lib/one-nation-bibliography";
import {
  oneNationFigures as figures,
  oneNationFigurePath,
  oneNationFigureViewerPath
} from "../../../lib/one-nation-figures";
import { candidatePreviewEnabled } from "../../../lib/news";

const localEditorialPreview = import.meta.env.BOHONEWS_LOCAL_PREVIEW === "1";
const previewMode = candidatePreviewEnabled || localEditorialPreview;
const storyPath = localEditorialPreview
  ? "/preview/one-nation-network/"
  : "/articles/one-nation-astroturf-news-network/";
const releaseFilePath = (name: string) => `${release.basePath}/${name}`;
const corpusFilePath = (name: string) => `${corpus.basePath}/${name}`;
const archive = release.files.find((file) => file.name === release.archiveFile);
const mirrorEntries = Object.entries(release.independentMirrors as Record<string,string | null>)
  .filter((entry): entry is [string,string] => typeof entry[1] === "string");
const mirrorLabels: Record<string,string> = {
  zenodo: "Zenodo",
  internetArchive: "Internet Archive"
};
const byteLabel = (bytes: number) => bytes < 1024
  ? `${bytes} bytes`
  : bytes < 1024 ** 2
    ? `${(bytes / 1024).toFixed(1)} KB`
    : bytes < 1024 ** 3
      ? `${(bytes / 1024 ** 2).toFixed(1)} MB`
      : `${(bytes / 1024 ** 3).toFixed(2)} GB`;
---

<BaseLayout
  title="One Nation astroturf network Evidence Room — Boho News"
  description="Original figures, public manifests, frozen-source archive controls and independent verification for Boho News's One Nation and Senate Leadership Fund network investigation."
  canonical="https://bohonews.com/evidence/one-nation-network/"
  noindex={previewMode}
>
  <article class="evidence-room one-nation-evidence-room" data-pagefind-body>
    {previewMode && <aside class="fixture-banner" role="status">Private editorial preview — not published</aside>}

    <header>
      <p class="eyebrow">Evidence Room · One Nation network investigation</p>
      <h1>See the proof for yourself</h1>
      <p>
        Every major claim in this investigation is backed by preserved public-web
        evidence. Start with the original figures, then go as deep as you want:
        public manifests, checksum ledgers, validation receipts and independent mirrors.
      </p>
    </header>

    <section class="evidence-summary" aria-label="Evidence release summary">
      <div><strong>8</strong><span>properties in the documented footprint</span></div>
      <div><strong>11</strong><span>unaltered article figures</span></div>
      <div><strong>30,333</strong><span>entries in the public-safe custody manifest</span></div>
    </section>

    <section class="evidence-primary evidence-story-link">
      <p class="evidence-id">The investigation</p>
      <h2>One Nation's network was bigger than reported</h2>
      <p>
        Boho News found a live North Carolina site promoted with Senate Leadership
        Fund money and a One Nation-branded Michigan build in an SLF development
        environment, extending the visible production footprint from six properties
        to eight states.
      </p>
      <p><a class="button" href={storyPath}>Read the full investigation</a></p>
    </section>

    <section aria-labelledby="freeze-title">
      <p class="evidence-id">Preservation</p>
      <h2 id="freeze-title">We froze what we saw before anyone had a reason to change it</h2>
      <p class="evidence-explainer">
        Before outreach, Boho News preserved the relevant pages, ads, public records
        and technical material. If a footer disappears, a privacy policy is rewritten,
        an ad is removed or a staging page goes dark, the frozen record remains checkable.
      </p>
      <p>
        We will continue monitoring the properties. After publication, any material
        change will be documented and reported as a change—not silently folded into
        the original record.
      </p>
    </section>

    <section aria-labelledby="figures-title">
      <p class="evidence-id">Original visual evidence</p>
      <h2 id="figures-title">The 11 figures used in the story</h2>
      <p class="evidence-explainer">
        These are the exact preserved PNG files used in the article. No arrows,
        highlights, text boxes or recreated graphics were added. Open any figure
        to inspect the full-resolution original.
      </p>
      <div class="evidence-figure-grid">
        {figures.map((figure) => <article id={`figure-${figure.number}`}>
          <a class:list={["evidence-figure-thumb", `evidence-figure-thumb--${figure.focus}`]} href={oneNationFigureViewerPath(figure)}>
            <img src={oneNationFigurePath(figure)} alt="" loading="lazy" />
          </a>
          <p class="evidence-id">Figure {figure.number}</p>
          <h3><a href={oneNationFigureViewerPath(figure)}>{figure.title}</a></h3>
          <p class="evidence-figure-card-actions">
            <a href={oneNationFigureViewerPath(figure)}>View clean evidence page</a>
            <a href={oneNationFigurePath(figure)} target="_blank" rel="noopener">Original PNG</a>
          </p>
        </article>)}
      </div>
      <p class="evidence-manifest-link">
        <a href={corpusFilePath("FIGURE-PROVENANCE-SHA256-20260820.csv")} download>
          Download figure provenance and SHA-256 ledger
        </a>
      </p>
    </section>

    <section class="evidence-primary evidence-bibliography" aria-labelledby="citation-library-title">
      <p class="evidence-id">Citation library</p>
      <h2 id="citation-library-title">Every numbered source behind the story</h2>
      <p>
        The story now carries claim-level numbered citations tied to a {oneNationBibliography.length}-item
        bibliography. It distinguishes public records, first-party pages, preserved exhibits,
        reproducible Boho News analysis and private right-of-reply correspondence.
      </p>
      <p class="evidence-actions">
        <a class="button" href="/evidence/one-nation-network/bibliography.json">Download machine-readable bibliography</a>
      </p>
      <details class="evidence-bibliography__details">
        <summary>Browse the complete bibliography</summary>
        <InvestigationBibliography headingLevel="h3" compact={true} />
      </details>
    </section>

    <section class="evidence-primary" aria-labelledby="manifest-title">
      <p class="evidence-id">Supplementary data</p>
      <h2 id="manifest-title">Download the public custody manifest</h2>
      <p>
        This is where the full inventory belongs—not in the middle of the story.
        The public-safe manifest accounts for every item in the sealed custody record.
        Restricted rows keep a stable ID, size, hash, category and publication
        disposition while omitting private identifying fields.
      </p>
      <p class="evidence-actions">
        <a class="button" href={corpusFilePath("PUBLIC-SAFE-FULL-CUSTODY-MANIFEST-20260820.csv")} download>
          Download CSV ({byteLabel(10111549)})
        </a>
        <a class="button button-secondary" href={corpusFilePath("PUBLIC-SAFE-FULL-CUSTODY-MANIFEST-20260820.jsonl")} download>
          Download JSONL ({byteLabel(16117236)})
        </a>
      </p>
      <dl>
        <div><dt>Custody entries</dt><dd>{corpus.custodyEntries.toLocaleString("en-US")}</dd></div>
        <div><dt>Accounted bytes</dt><dd>{byteLabel(corpus.custodyBytes)}</dd></div>
        <div><dt>CSV SHA-256</dt><dd><code>9af25e4a1935b49c2a6f8c4b22eea82cdd6e1e0b3e169c93769df84e3915e2e0</code></dd></div>
      </dl>
    </section>

    <section aria-labelledby="corpus-title">
      <p class="evidence-id">Frozen public-source corpus</p>
      <h2 id="corpus-title">The source archive is data, not a working copy of the political sites</h2>
      <p class="evidence-explainer">
        The independently validated corpus contains {corpus.uniquePublicSourceObjects.toLocaleString("en-US")}{" "}
        unique public-source objects selected from {corpus.selectedPublicSourceRows.toLocaleString("en-US")}{" "}
        custody rows. It does not execute captured code, submit forms, load trackers or
        reconstruct the sites as navigable mirrors.
      </p>
      <div class="archive-spec">
        <div><span>Archive size</span><strong>{byteLabel(corpus.archive.bytes)}</strong></div>
        <div><span>Unique objects</span><strong>{corpus.uniquePublicSourceObjects.toLocaleString("en-US")}</strong></div>
        <div><span>Validation</span><strong>PASS</strong></div>
      </div>
      <p class="hash"><strong>Archive SHA-256</strong> <code>{corpus.archive.sha256}</code></p>
      <p class="preview-host-note">
        The {byteLabel(corpus.archive.bytes)} archive is too large for the newsroom convenience mirror. Its
        Zenodo and Internet Archive download links will appear here after the hosted
        copies are downloaded independently and matched against this hash.
      </p>
      <p>
        <a href={corpusFilePath("FROZEN-PUBLIC-SOURCE-CORPUS-MANIFEST-20260820.csv")} download>Corpus manifest</a>
        {" · "}
        <a href={corpusFilePath("FROZEN-PUBLIC-SOURCE-OBJECT-SHA256SUMS-20260820.txt")} download>Object checksum ledger</a>
        {" · "}
        <a href={corpusFilePath("PUBLIC-ARCHIVE-BUILD-SUMMARY-20260820.json")}>Build receipt</a>
        {" · "}
        <a href={corpusFilePath("PUBLIC-ARCHIVE-INDEPENDENT-VALIDATION-20260820.json")}>Independent validation receipt</a>
      </p>
    </section>

    <section aria-labelledby="files-title">
      <p class="evidence-id">Convenience copies</p>
      <h2 id="files-title">All supplementary files hosted by Boho News</h2>
      <div class="evidence-list">
        {corpus.files.map((file) => <article>
          <h3><a href={corpusFilePath(file.name)}>{file.title}</a></h3>
          <p>{file.name} · {byteLabel(file.bytes)}</p>
          <p class="hash"><strong>SHA-256</strong> <code>{file.sha256}</code></p>
        </article>)}
      </div>
      <p class="hash fileset-root"><strong>Publication fileset ledger SHA-256</strong> <code>{corpus.publicationFilesetLedgerSha256}</code></p>
    </section>

    <section aria-labelledby="companion-title">
      <p class="evidence-id">Complete public package · Version 1.0.0</p>
      <h2 id="companion-title">Earlier signed evidence companion</h2>
      <p>
        The smaller signed companion contains the report, methodology, limitations,
        claim and evidence indexes, signatures and OpenTimestamps proof. It remains
        available here and through two independent hosts.
      </p>
      {archive && <p><a class="button" href={releaseFilePath(archive.name)} download>Download complete public package ({byteLabel(archive.bytes)})</a></p>}
      <dl class="companion-integrity">
        <div><dt>Archive SHA-256</dt><dd><code>{release.archiveSha256}</code></dd></div>
        <div><dt>Signing-key fingerprint</dt><dd><code>{release.signingKeyFingerprint}</code></dd></div>
        <div><dt>Bitcoin block</dt><dd>{release.openTimestamps.bitcoinBlockHeight}</dd></div>
      </dl>
      <p>
        <a href={`${release.basePath}/manifest.json`}>Machine-readable release manifest</a>
        {" · "}
        <a href={releaseFilePath("DISTRIBUTION-SHA256SUMS.txt")}>SHA-256 ledger</a>
        {" · "}
        <a href={releaseFilePath("PUBLIC-RELEASE-OTS-VERIFICATION.json")}>Timestamp verification receipt</a>
      </p>
    </section>

    <section aria-labelledby="mirrors-title">
      <p class="evidence-id">Independent preservation</p>
      <h2 id="mirrors-title">Verified third-party mirrors for version 1.0.0</h2>
      {mirrorEntries.length > 0
        ? <ul>{mirrorEntries.map(([host,url]) => <li><a href={url} rel="noopener noreferrer">{mirrorLabels[host] ?? host}</a></li>)}</ul>
        : <p>
            Zenodo and Internet Archive links will be added only after every
            hosted file has been downloaded independently and matched against
            the SHA-256 values above.
          </p>}
    </section>

    <section aria-labelledby="withheld-title">
      <p class="evidence-id">What is not public</p>
      <h2 id="withheld-title">The manifest accounts for restricted material without exposing it</h2>
      <p>
        We do not publish raw correspondence, full email headers, credentials,
        authenticated browser state, unrelated personal information, security-bearing
        network records, internal legal or editorial work, or unresolved leads that
        did not survive verification. The manifest records that those items exist and
        binds them to hashes without disclosing the private fields themselves.
      </p>
      <p>
        Boho News will consider focused verification requests from directly affected
        parties, journalists, researchers or counsel. Depending on the material, that
        may mean a hash attestation, redacted excerpt, reviewed copy or supervised inspection.
      </p>
    </section>

    <section class="evidence-note">
      <h2>Hashes prove exact bytes—not intent</h2>
      <p>
        SHA-256, signatures and timestamps let readers verify that a file is the same
        file Boho News released and that we possessed it by a particular time. They do
        not independently establish that every statement inside a captured page is true
        or explain why an operator made a particular choice.
      </p>
      <p>
        If a correction requires different bytes, Boho News will issue a new numbered
        evidence version while preserving prior identifiers and hashes.
      </p>
    </section>
  </article>
</BaseLayout>
