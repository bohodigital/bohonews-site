---
import GamePerformance from "../../components/games/GamePerformance.astro";
import GamesLayout from "../../layouts/GamesLayout.astro";
---

<GamesLayout title="Mini Crossword" description="Play unlimited hand-reviewed 4x4 Mini Crossword puzzles from Boho News." game="Mini Crossword">
  <header class="game-heading">
    <p class="eyebrow">Unlimited original clues</p><h1>Mini Crossword</h1>
    <p class="game-heading__dek">Eight clues. Sixteen squares. Another compact puzzle is always ready.</p>
    <div class="game-meta"><span data-mini-number>Game 1</span><span data-mini-size>Compact grid</span><span data-mini-stats>0 solved</span></div>
  </header>
  <GamePerformance rules="Each puzzle gets a calculated perfect time from its 16 squares, eight clues, and unusual letters. Score is 4,000 + 4,000 × perfect time ÷ solve time, minus 600 for each unsuccessful check. The speed term has no mathematical ceiling." />
  <section class="mini-layout" data-mini-game>
    <div>
      <p class="game-status" role="status" aria-live="polite">Building a fresh crossword…</p>
      <div class="mini-current-clue" data-mini-current-clue aria-live="polite"><strong>1 Across</strong><span>Select a square to begin.</span></div>
      <div class="mini-grid" role="grid" aria-label="Mini Crossword grid" data-mini-grid></div>
      <div class="game-actions">
        <button class="game-button" type="button" data-mini-check>Check puzzle</button>
        <button class="game-button game-button--secondary" type="button" data-mini-new>New crossword</button>
        <button class="game-button game-button--secondary" type="button" data-mini-clear>Clear entries</button>
      </div>
    </div>
    <div class="mini-clues">
      <section><h2>Across</h2><ol data-mini-across></ol></section>
      <section><h2>Down</h2><ol data-mini-down></ol></section>
    </div>
  </section>
  <p class="game-note">Puzzles come from a validated 4×4 Boho pack. Your current puzzle stays on this device.</p>
</GamesLayout>

<script>
  // @ts-nocheck -- Browser interaction is covered by focused unit and browser QA.
  import { MINI4_PUZZLES } from "../../lib/games/crossword-mini4-pack";
  import { mini4ToLayout } from "../../lib/games/crossword-mini4";
  import { attachGamePerformance } from "../../lib/games/performance";
  import { miniCrosswordPoints, miniPerfectSeconds, pointsBucket } from "../../lib/games/scoring";

  const root = document.querySelector("[data-mini-game]");
  if (root) {
    const STORAGE_KEY="boho-games:v2";
    const grid=root.querySelector("[data-mini-grid]"); const status=root.querySelector(".game-status");
    const acrossList=root.querySelector("[data-mini-across]"); const downList=root.querySelector("[data-mini-down]");
    const currentClue=root.querySelector("[data-mini-current-clue]");
    let store=readStore(); let state=validState(store.mini?.current)?store.mini.current:null;
    let selectedIndex=-1; let direction="across";let performanceTracker=null;

    function readStore(){try{return JSON.parse(localStorage.getItem(STORAGE_KEY)||"{}");}catch{return {};}}
    function writeStore(){try{localStorage.setItem(STORAGE_KEY,JSON.stringify(store));}catch{}}
    function validState(value){const puzzle=MINI4_PUZZLES.find((entry)=>entry.id===value?.puzzleId);return value?.format==="mini4-v1"&&puzzle&&Number.isInteger(value.number)&&value.number>0&&value.rows===4&&value.cols===4&&Array.isArray(value.table)&&value.table.length===4&&value.table.every((row)=>Array.isArray(row)&&row.length===4)&&Array.isArray(value.entries)&&value.entries.length===16&&value.entries.every((entry)=>entry===""||entry==="-"||/^[A-Z]$/.test(entry))&&Array.isArray(value.result)&&value.result.length===8;}
    function puzzleForNumber(number){return MINI4_PUZZLES[((number-1)*7)%MINI4_PUZZLES.length];}
    function freshGame(){
      const mini=store.mini||{sequence:0,stats:{played:0,solved:0}};const number=(mini.sequence||0)+1;const puzzle=puzzleForNumber(number);const layout=mini4ToLayout(puzzle);
      state={number,format:"mini4-v1",puzzleId:puzzle.id,...layout,entries:layout.table.flat().map(()=>""),complete:false,recorded:false,reported:false,failedChecks:0};
      selectedIndex=-1;direction="across";
      store.mini={...mini,sequence:state.number,current:state};writeStore();performanceTracker?.reset();render();focusSelected();status.textContent="1 Across is selected. Start typing.";
    }
    if(!state)freshGame();
    else {Object.assign(state,mini4ToLayout(MINI4_PUZZLES.find((entry)=>entry.id===state.puzzleId)));state.failedChecks??=0;}

    function numberMap(){const map=new Map();state.result.forEach((entry)=>map.set(`${entry.starty-1},${entry.startx-1}`,entry.position));return map;}
    function solutionAt(index){const row=Math.floor(index/state.cols),col=index%state.cols;return state.table[row][col].toUpperCase();}
    function saveEntry(index,value){if(state.complete)return;state.entries[index]=value;writeStore();}
    async function reportCompletion(){if(state.reported||!state.complete)return;const submitted=await window.BohoGameStats?.submit({game:"mini",variant:"standard",outcome:"solved",scoreBucket:pointsBucket(state.points||0)});if(submitted){state.reported=true;writeStore();}}
    function entryCells(entry){const start=(entry.starty-1)*state.cols+(entry.startx-1);const step=entry.orientation==="across"?1:state.cols;return Array.from({length:entry.answer.length},(_,offset)=>start+offset*step);}
    function entriesForCell(index){return state.result.filter((entry)=>entryCells(entry).includes(index));}
    function sortedEntries(orientation){return state.result.filter((entry)=>entry.orientation===orientation).sort((a,b)=>a.position-b.position);}
    function currentEntry(){const entries=entriesForCell(selectedIndex);return entries.find((entry)=>entry.orientation===direction)||entries[0]||null;}
    function ensureSelection(){
      if(state.entries[selectedIndex]!==undefined&&state.entries[selectedIndex]!=="-")return;
      const first=sortedEntries("across")[0]||state.result[0];
      if(first){direction=first.orientation;selectedIndex=entryCells(first)[0];}
    }
    function focusSelected(){grid.querySelector(`[data-mini-cell="${selectedIndex}"]`)?.focus();}
    function updateSelection(){
      ensureSelection();
      const entry=currentEntry();const wordCells=new Set(entry?entryCells(entry):[]);
      grid.querySelectorAll(".mini-cell").forEach((cell)=>{const index=Number(cell.dataset.miniIndex);cell.toggleAttribute("data-in-word",wordCells.has(index));cell.toggleAttribute("data-active",index===selectedIndex);});
      grid.querySelectorAll("[data-mini-cell]").forEach((input)=>input.setAttribute("aria-selected",String(Number(input.dataset.miniCell)===selectedIndex)));
      root.querySelectorAll("[data-mini-clue]").forEach((button)=>button.toggleAttribute("aria-current",Boolean(entry&&button.dataset.miniClue===`${entry.orientation}-${entry.position}`)));
      if(entry){currentClue.querySelector("strong").textContent=`${entry.position} ${entry.orientation==="across"?"Across":"Down"}`;currentClue.querySelector("span").textContent=entry.clue;}
    }
    function selectCell(index,{directionHint=null,toggle=false,focus=true}={}){
      if(state.entries[index]===undefined||state.entries[index]==="-")return;
      const available=entriesForCell(index).map((entry)=>entry.orientation);
      if(toggle&&index===selectedIndex&&available.length>1)direction=direction==="across"?"down":"across";
      else if(directionHint&&available.includes(directionHint))direction=directionHint;
      else if(!available.includes(direction))direction=available[0]||direction;
      selectedIndex=index;updateSelection();if(focus)focusSelected();
    }
    function selectClue(entry,stepToBlank=true){
      direction=entry.orientation;const cells=entryCells(entry);selectedIndex=stepToBlank?(cells.find((index)=>!state.entries[index])??cells[0]):cells[0];updateSelection();focusSelected();
    }
    function cycleClue(step){
      const entries=sortedEntries(direction);const active=currentEntry();let index=entries.indexOf(active);if(index<0)index=0;selectClue(entries[(index+step+entries.length)%entries.length]);
    }
    function moveWithinEntry(step,{skipFilled=false}={}){
      const entry=currentEntry();if(!entry)return false;const cells=entryCells(entry);const position=cells.indexOf(selectedIndex);
      if(skipFilled){for(let cursor=position+step;cursor>=0&&cursor<cells.length;cursor+=step){if(!state.entries[cells[cursor]]){selectCell(cells[cursor],{directionHint:direction});return true;}}return false;}
      const next=cells[position+step];if(next===undefined)return false;selectCell(next,{directionHint:direction});return true;
    }
    function arrowTarget(index,key){
      const row=Math.floor(index/state.cols),col=index%state.cols;const delta=key==="ArrowRight"?1:key==="ArrowLeft"?-1:key==="ArrowDown"?state.cols:-state.cols;
      const cursor=index+delta;if(cursor<0||cursor>=state.entries.length)return null;const nextRow=Math.floor(cursor/state.cols),nextCol=cursor%state.cols;
      if((key==="ArrowRight"||key==="ArrowLeft")&&nextRow!==row)return null;if((key==="ArrowDown"||key==="ArrowUp")&&nextCol!==col)return null;
      return state.entries[cursor]!=="-"?cursor:null;
    }
    function renderClues(list,orientation){
      list.textContent="";
      sortedEntries(orientation).forEach((entry)=>{const item=document.createElement("li");const button=document.createElement("button");const number=document.createElement("span");number.textContent=entry.position;button.type="button";button.dataset.miniClue=`${entry.orientation}-${entry.position}`;button.append(number,document.createTextNode(entry.clue));button.addEventListener("click",()=>selectClue(entry));item.append(button);list.append(item);});
    }
    function render(){
      grid.textContent="";grid.style.setProperty("--mini-cols",state.cols);const starts=numberMap();
      state.table.flat().forEach((solution,index)=>{
        if(solution==="-"){const block=document.createElement("div");block.className="mini-block";block.setAttribute("aria-hidden","true");grid.append(block);return;}
        const row=Math.floor(index/state.cols),col=index%state.cols;const label=document.createElement("label");label.className="mini-cell";label.dataset.miniIndex=index;
        const number=document.createElement("span");number.textContent=starts.get(`${row},${col}`)||"";
        const input=document.createElement("input");input.maxLength=1;input.autocomplete="off";input.inputMode="text";input.value=state.entries[index]||"";input.dataset.miniCell=index;input.setAttribute("aria-label",`Row ${row+1}, column ${col+1}`);
        input.disabled=state.complete;
        input.addEventListener("pointerdown",()=>{input.dataset.wasActive=String(index===selectedIndex);});
        input.addEventListener("click",()=>selectCell(index,{toggle:input.dataset.wasActive==="true"}));
        input.addEventListener("focus",()=>{if(index!==selectedIndex)selectCell(index,{focus:false});});
        input.addEventListener("input",()=>{if(state.complete)return;input.value=input.value.replace(/[^a-z]/gi,"").slice(-1).toUpperCase();input.removeAttribute("aria-invalid");saveEntry(index,input.value);if(input.value)moveWithinEntry(1,{skipFilled:true});});
        input.addEventListener("keydown",(event)=>{
          if(["ArrowRight","ArrowLeft","ArrowDown","ArrowUp"].includes(event.key)){const next=arrowTarget(index,event.key);if(next!==null){event.preventDefault();selectCell(next,{directionHint:event.key==="ArrowRight"||event.key==="ArrowLeft"?"across":"down"});}return;}
          if(event.key===" "&&entriesForCell(index).length>1){event.preventDefault();selectCell(index,{toggle:true});return;}
          if(event.key==="Enter"||event.key==="Tab"){event.preventDefault();cycleClue(event.shiftKey?-1:1);return;}
          if(event.key==="Backspace"){event.preventDefault();if(input.value){input.value="";saveEntry(index,"");}else if(moveWithinEntry(-1)){const previous=grid.querySelector(`[data-mini-cell="${selectedIndex}"]`);previous.value="";saveEntry(selectedIndex,"");}return;}
          if(event.key==="Delete"){event.preventDefault();input.value="";saveEntry(index,"");}
        });
        label.append(number,input);grid.append(label);
      });
      renderClues(acrossList,"across");renderClues(downList,"down");
      document.querySelector("[data-mini-number]").textContent=`Game ${state.number}`;document.querySelector("[data-mini-size]").textContent=`${state.rows}×${state.cols} grid`;
      const stats=store.mini.stats||{played:0,solved:0};document.querySelector("[data-mini-stats]").textContent=`${stats.solved} solved`;
      status.textContent=state.complete?"Puzzle complete. Nicely done.":"Type to fill. Space switches direction; Enter or Tab moves to the next clue.";updateSelection();
    }
    function check(){if(state.complete)return;let wrong=0,blank=0;grid.querySelectorAll("[data-mini-cell]").forEach((input)=>{const index=Number(input.dataset.miniCell),value=input.value.toUpperCase();if(value&&value!==solutionAt(index)){input.setAttribute("aria-invalid","true");wrong++;}else input.removeAttribute("aria-invalid");if(!value)blank++;});if(!wrong&&!blank){state.complete=true;if(!state.recorded){store.mini.stats=store.mini.stats||{played:0,solved:0};store.mini.stats.played++;store.mini.stats.solved++;state.recorded=true;}performanceTracker?.finish();status.textContent="Puzzle complete. Nicely done.";writeStore();render();void reportCompletion();}else{state.failedChecks=(state.failedChecks||0)+1;performanceTracker?.render();writeStore();status.textContent=wrong?`${wrong} ${wrong===1?"square needs":"squares need"} another look.`:`${blank} ${blank===1?"square remains":"squares remain"}.`;}}
    root.querySelector("[data-mini-check]")?.addEventListener("click",check);
    root.querySelector("[data-mini-new]")?.addEventListener("click",freshGame);
    root.querySelector("[data-mini-clear]")?.addEventListener("click",()=>{if(state.complete)return;state.entries=state.entries.map((value)=>value==="-"?"-":"");writeStore();selectedIndex=-1;direction="across";render();focusSelected();});
    performanceTracker=attachGamePerformance(document,{getState:()=>state,save:writeStore,calculatePoints:(elapsedMs)=>miniCrosswordPoints({elapsedMs,perfectSeconds:miniPerfectSeconds(state.result.map((entry)=>entry.answer)),failedChecks:state.failedChecks||0})});
    render();focusSelected();
  }
</script>
