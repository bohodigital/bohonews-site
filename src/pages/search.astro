---
import BaseLayout from "../layouts/BaseLayout.astro";
import { fixturesEnabled } from "../lib/news";
---
<BaseLayout title="Search — Boho News" description="Search approved Boho News articles." noindex={fixturesEnabled}>
  <section class="search-page"><p class="eyebrow">Search</p><h1>Search Boho News</h1>
    <div id="search" aria-live="polite"><p>Loading the local search index…</p></div>
    <noscript><p>Search requires JavaScript. All article and section pages remain readable without it.</p></noscript>
  </section>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline type="module" src="/search-init.js"></script>
</BaseLayout>
