        <figcaption>The eight-property record</figcaption>
        <div class="table-scroll">
          <table>
            <thead><tr><th scope="col">Property</th><th scope="col">State</th><th scope="col">Captured status</th><th scope="col">Direct attribution in the preserved record</th></tr></thead>
            <tbody>
              <tr><th scope="row">Alaska Navigator</th><td>Alaska</td><td>Live</td><td>One Nation</td></tr>
              <tr><th scope="row">Maine Policy Updates</th><td>Maine</td><td>Live</td><td>One Nation</td></tr>
              <tr><th scope="row">Iowa Voice</th><td>Iowa</td><td>Live</td><td>One Nation</td></tr>
              <tr><th scope="row">Ohio Pulse</th><td>Ohio</td><td>Live</td><td>One Nation</td></tr>
              <tr><th scope="row">Peach State Post</th><td>Georgia</td><td>Live</td><td>One Nation; Meta records also identify One Nation responsibility</td></tr>
              <tr><th scope="row">New Hampshire Daily</th><td>New Hampshire</td><td>Live</td><td>One Nation</td></tr>
              <tr><th scope="row">The North Carolinian</th><td>North Carolina</td><td>Live</td><td>SLF footer and Meta payer disclosure; One Nation privacy-language residue</td></tr>
