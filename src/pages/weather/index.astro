---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/weather.css";
---
<BaseLayout title="Local Weather Forecast | Boho News" description="Local and global weather forecasts with official U.S. alerts, hourly conditions and transparent sources." canonical={new URL("/weather/", Astro.site).toString()}>
  <section class="weather-hero" aria-labelledby="weather-title">
    <div><p class="eyebrow">Boho Weather</p><h1 id="weather-title">Weather where you are.</h1><p class="weather-intro">A fast local forecast with global coverage, official U.S. alerts and the source of every number in view.</p></div>
    <div class="weather-location-panel">
      <p id="weather-location-kind">Finding an approximate location…</p>
      <form id="weather-location-search" role="search">
        <label for="weather-location-query">Change location</label>
        <div><input id="weather-location-query" name="q" type="search" autocomplete="off" placeholder="City or region" maxlength="100" /><button type="submit">Search</button></div>
      </form>
      <div id="weather-location-results" class="weather-location-results" aria-live="polite"></div>
      <button id="weather-device-location" class="weather-secondary-button" type="button">Use precise device location</button>
    </div>
  </section>
  <p id="weather-status" class="weather-status" role="status">Loading local forecast…</p>
  <section id="weather-current" class="weather-current" aria-labelledby="weather-current-title" hidden>
    <div><p class="eyebrow">Now</p><h2 id="weather-current-title">Current conditions</h2><p id="weather-summary"></p></div>
    <p id="weather-temperature" class="weather-temperature"></p>
    <dl class="weather-facts"><div><dt>Wind</dt><dd id="weather-wind">—</dd></div><div><dt>Humidity</dt><dd id="weather-humidity">—</dd></div><div><dt>Precipitation</dt><dd id="weather-precipitation">—</dd></div><div><dt>Updated</dt><dd id="weather-updated">—</dd></div></dl>
    <button id="weather-unit-toggle" class="weather-unit-toggle" type="button">Show °F</button>
  </section>
  <section id="weather-alerts-section" class="weather-section" aria-labelledby="weather-alerts-title" hidden><div class="module-heading"><h2 id="weather-alerts-title">Active alerts</h2><p class="eyebrow">Official warnings</p></div><div id="weather-alerts"></div></section>
  <section class="weather-section" aria-labelledby="weather-hourly-title"><div class="module-heading"><h2 id="weather-hourly-title">Next 24 hours</h2><p class="eyebrow">Hourly</p></div><div id="weather-hourly" class="weather-hourly" aria-live="polite"></div></section>
  <section class="weather-section" aria-labelledby="weather-daily-title"><div class="module-heading"><h2 id="weather-daily-title">Extended forecast</h2><p class="eyebrow">Daily outlook</p></div><div id="weather-daily" class="weather-daily" aria-live="polite"></div></section>
  <section class="weather-radar-next" aria-labelledby="weather-radar-title"><div><p class="eyebrow">Phase 4 foundation</p><h2 id="weather-radar-title">Radar infrastructure is next.</h2><p>The edge service already exposes a versioned layer manifest. Observed U.S. radar, warning overlays and the Weather Nerd Dashboard can attach without exposing the Pi.</p></div><a href="/weather-climate/">Weather and climate coverage</a></section>
  <footer class="weather-provenance"><p id="weather-source">Weather sources will appear here.</p><p>Approximate location comes from Cloudflare when available. Boho News does not store your IP address for this forecast.</p></footer>
  <script is:inline src="/weather.js" defer></script>
</BaseLayout>
