---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsVisual from "../components/NewsVisual.astro";
import StoryCard from "../components/StoryCard.astro";
import {
  candidatePreviewEnabled, candidateUnpublishedEnabled, fixturesEnabled, formatTimestamp,
  homepageArticles, homepageElectionArticleId, sectionArticles
} from "../lib/news";
const latest = homepageArticles(sectionArticles("latest"));
const homepageElectionStory = latest.find((article) => article.id === homepageElectionArticleId);
const nonElectionLatest = latest.filter((article) => article.desk !== "elections");
const latestWire = nonElectionLatest.slice(0,12);
const featuredArticleId = "article-one-nation-astroturf-network";
const lead = nonElectionLatest.find((article) => article.id === featuredArticleId) ?? nonElectionLatest[0];
const secondary = [
  ...(homepageElectionStory ? [homepageElectionStory] : []),
  ...nonElectionLatest.filter((article) => article.id !== lead?.id)
].slice(0,2);
const secondaryIds = new Set(secondary.map((article) => article.id));
const topStories = nonElectionLatest.filter((article) => article.id !== lead?.id && !secondaryIds.has(article.id));
const politics = sectionArticles("politics").filter((article) => article.desk !== "elections");
const business = sectionArticles("business");
const explainers = nonElectionLatest.filter((article) => article.articleType === "explainer");
---

<BaseLayout
  title="Boho News — Latest news, context, and public evidence"
  description="Boho News presents broad, continuously updated coverage through a fast, evidence-forward newsroom."
  noindex={candidateUnpublishedEnabled || fixturesEnabled}
>
  {candidatePreviewEnabled && <aside class="fixture-banner" role="status">Preview candidate — not published</aside>}
  {fixturesEnabled && <aside class="fixture-banner" role="status">Non-production fixture preview — synthetic records are excluded from public promotion.</aside>}
  {fixturesEnabled && <a class="breaking-strip" href="/articles/fixture-developing/"><strong>Interface preview</strong><span>Synthetic breaking-news state for responsive visual testing</span><time>Updated 11:15 UTC</time></a>}

  {lead ? <section class="lead-composition" aria-label="Top stories">
    <article class="dominant-story">
      {lead.leadImage && <img class="dominant-story__image" src={lead.leadImage.src} alt={lead.leadImage.alt ?? ""} width={lead.leadImage.width} height={lead.leadImage.height} loading="eager" />}
      <p class="story-status"><span>{lead.section}</span>{lead.articleType === "developing-story" && <strong>Developing</strong>}</p>
      <h1><a href={`/articles/${lead.slug}/`}>{lead.headline}</a></h1>
      <p class="lead-dek">{lead.dek}</p>
      {lead.updatedAt && <p class="meta">Updated <time datetime={lead.updatedAt}>{formatTimestamp(lead.updatedAt)}</time></p>}
    </article>
    <div class="secondary-stack">
      {secondary.map((article,index) => <StoryCard article={article} prominent={index === 0} />)}
    </div>
    <aside class="latest-wire" aria-labelledby="wire-title">
      <div class="module-heading"><p class="eyebrow">Continuous desk</p><h2 id="wire-title">Latest</h2></div>
      <ol>{latestWire.map((article) => <li>{article.updatedAt && <time datetime={article.updatedAt}>{formatTimestamp(article.updatedAt)}</time>}<a href={`/articles/${article.slug}/`}>{article.headline}</a><span>{article.section}</span></li>)}</ol>
      <a class="text-link" href="/latest/">View all latest →</a>
    </aside>
  </section> :
  <section class="production-empty" aria-labelledby="latest-heading">
    <p class="eyebrow">Latest</p><h1 id="latest-heading">No public articles have been promoted.</h1>
    <p>The newsroom shell is ready. Approved reporting will populate this page through the governed publishing system.</p>
  </section>}

  {lead && !fixturesEnabled && <>
    <section class="top-story-row" aria-labelledby="top-stories-title">
      <div class="module-heading"><p class="eyebrow">Across the newsroom</p><h2 id="top-stories-title">Top stories</h2></div>
      <div>{topStories.map((article) => <StoryCard article={article} />)}</div>
    </section>

    <div class="paired-desks">
      <section class="desk-module" aria-labelledby="politics-title">
        <div class="module-heading"><p class="eyebrow">Institutions & policy</p><h2 id="politics-title"><a href="/politics/">Politics</a></h2></div>
        <div class="desk-story-list">{politics.map((article) => <StoryCard article={article} />)}</div>
      </section>
      <section class="desk-module" aria-labelledby="business-title">
        <div class="module-heading"><p class="eyebrow">Economy & technology</p><h2 id="business-title"><a href="/business/">Business</a></h2></div>
        <div class="desk-story-list">{business.map((article) => <StoryCard article={article} />)}</div>
      </section>
    </div>

    <section class="desk-module desk-module--wide" aria-labelledby="explainers-title">
      <div class="module-heading"><p class="eyebrow">How it works</p><h2 id="explainers-title"><a href="/politics/explainers/">Explainers</a></h2></div>
      <div class="story-grid">{explainers.map((article) => <StoryCard article={article} />)}</div>
    </section>
  </>}

  {fixturesEnabled && <>
    <section class="desk-module desk-module--wide" aria-labelledby="us-title">
      <div class="module-heading"><p class="eyebrow">National desk</p><h2 id="us-title"><a href="/us/">U.S.</a></h2></div>
      <div class="desk-split"><NewsVisual variant="world" label="Synthetic U.S. desk visual" /><div class="headline-list">
        <h3>Section lead presentation</h3><p>Neutral fixture copy demonstrates a national-news module without asserting real events.</p>
        <a class="text-link" href="/us/">Open the U.S. desk →</a>
      </div></div>
    </section>

    <div class="paired-desks">
      <section class="desk-module" aria-labelledby="world-title">
        <div class="module-heading"><p class="eyebrow">Global desk</p><h2 id="world-title"><a href="/world/">World</a></h2></div>
        <NewsVisual variant="world" label="Synthetic global coverage visual" compact />
        <h3>Region-aware world coverage shell</h3><p>Maps, local time, sourcing, and uncertainty have dedicated visual positions.</p>
      </section>
      <section class="desk-module" aria-labelledby="justice-title">
        <div class="module-heading"><p class="eyebrow">Public safety</p><h2 id="justice-title"><a href="/crime-justice/">Crime & Justice</a></h2></div>
        <NewsVisual variant="justice" label="Synthetic court and case visual" compact />
        <div class="status-card"><strong>Active incident</strong><span>Structured status presentation</span><small>Last confirmed update displayed here</small></div>
      </section>
    </div>

    <section class="weather-module" aria-labelledby="weather-title">
      <div class="weather-map"><NewsVisual variant="weather" label="Synthetic weather alert map" /></div>
      <div>
        <div class="module-heading"><p class="eyebrow">Interface sample · not live data</p><h2 id="weather-title"><a href="/weather-climate/">Weather now</a></h2></div>
        <ul class="alert-list">
          <li><strong>Alert state</strong><span>Multi-state region</span><time>Expiration shown here</time></li>
          <li><strong>Warning state</strong><span>Metro or disaster region</span><time>Official update time</time></li>
          <li><strong>Tropical outlook</strong><span>Formation probability module</span><time>Source timestamp</time></li>
        </ul>
      </div>
    </section>

    <div class="paired-desks">
      <section class="desk-module" aria-labelledby="politics-title">
        <div class="module-heading"><p class="eyebrow">Institutions & policy</p><h2 id="politics-title"><a href="/politics/">Politics</a></h2></div>
        <NewsVisual variant="document" label="Synthetic public document visual" compact />
        <h3>Votes, documents, money, and consequences</h3><p>Campaign coverage does not displace accountability reporting.</p>
      </section>
      <section class="desk-module" aria-labelledby="business-title">
        <div class="module-heading"><p class="eyebrow">Economy</p><h2 id="business-title"><a href="/business/">Business</a></h2></div>
        <div class="data-card"><strong>Key number</strong><span>—</span><p>Approved economic data and its timestamp appear here.</p></div>
      </section>
    </div>

    <section class="triple-desks" aria-label="Health, science, and technology">
      {[
        ["Health","health-science","Evidence and public-health alert modules."],
        ["Science","health-science","Study design, limitations, and funding."],
        ["Technology","technology","Systems, companies, privacy, and policy."]
      ].map(([label,route,text],index) => <article><NewsVisual variant="science" label={`Synthetic ${label} visual`} compact /><p class="eyebrow">Desk</p><h2><a href={`/${route}/`}>{label}</a></h2><p>{text}</p><span class="sequence">0{index + 1}</span></article>)}
    </section>

    <section class="evidence-module" aria-labelledby="evidence-title">
      <div class="module-heading"><p class="eyebrow">Show the work</p><h2 id="evidence-title">Documents, data & visuals</h2></div>
      <div class="evidence-grid">
        <article class="document-card"><span class="document-sheet"><i></i><i></i><i></i><i></i></span><div><p class="label">Document</p><h3>Primary-record viewer</h3><p>Issuer, date, excerpts, and related coverage.</p></div></article>
        <article class="chart-card"><div class="bar-chart" role="img" aria-label="Synthetic four-bar data chart"><i></i><i></i><i></i><i></i></div><div><p class="label">Data</p><h3>Accessible chart system</h3><p>Direct labels, source, and timestamp.</p></div></article>
        <article><NewsVisual variant="culture" label="Synthetic visual-story treatment" compact /><p class="label">Visual story</p><h3>Photography, maps, and graphics</h3></article>
      </div>
    </section>

    <section class="investigation-module" aria-labelledby="investigation-title">
      <div><p class="eyebrow">Investigations</p><h2 id="investigation-title">Evidence-forward feature treatment</h2><p>Large visuals, restrained brass accents, source documents, and a concise findings summary.</p><a class="button" href="/investigations/">View the investigations desk</a></div>
      <NewsVisual variant="document" label="Synthetic investigation evidence visual" />
    </section>

    <section class="newsletter-module" aria-labelledby="newsletter-title">
      <div><p class="eyebrow">Direct from the newsroom</p><h2 id="newsletter-title">Newsletters</h2><p>Subscription functionality remains disabled until an approved provider and privacy flow exist.</p></div>
      <form aria-label="Newsletter signup status"><label for="newsletter-email">Email address</label><div><input id="newsletter-email" type="email" placeholder="reader@example.com" disabled /><button type="button" disabled>Unavailable</button></div></form>
    </section>
  </>}
</BaseLayout>
