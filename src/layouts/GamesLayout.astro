---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  game?: string;
}

const { title, description, game } = Astro.props;
---

<BaseLayout title={`${title} — Boho News`} description={description} noindex hideMarketTicker defaultTheme="light">
  <div class="games-shell">
    <nav class="games-crumbs" aria-label="Games navigation">
      <a href="/games/">Boho Games</a>
      {game && <><span aria-hidden="true">/</span><span>{game}</span></>}
    </nav>
    <slot />
    <aside class="game-sharing" aria-labelledby="game-sharing-title">
      <div>
        <h2 id="game-sharing-title">Community play counts</h2>
        <p data-community-stats>Checking community totals…</p>
      </div>
      <label>
        <input type="checkbox" data-game-stats-opt-in />
        <span><strong>Share anonymous results</strong> — off by default. Sends only the game, outcome, and a coarse score after you finish. No account or player identifier.</span>
      </label>
    </aside>
  </div>
  <script is:inline src="/game-stats.js" defer></script>
</BaseLayout>

<style is:global>
  .games-shell {
    --game-green: #1f6b4f;
    --game-gold: #c69635;
    --game-ink: #24211d;
    margin: 0 auto;
    max-width: 76rem;
    min-height: 62vh;
  }
  :root[data-theme="dark"] .games-shell { --game-green: #66bd98; --game-gold: #e0b65c; --game-ink: #f1eee8; }
  .games-crumbs {
    align-items: center;
    border-bottom: 1px solid var(--border);
    display: flex;
    font-size: .7rem;
    font-weight: 850;
    gap: .55rem;
    letter-spacing: .08em;
    margin-bottom: clamp(2rem,5vw,4.5rem);
    padding: .7rem 0;
    text-transform: uppercase;
  }
  .games-crumbs a { color: var(--accent); text-decoration: none; }
  .games-hero { align-items: end; display: grid; gap: 2rem; grid-template-columns: minmax(0,1.4fr) minmax(16rem,.6fr); margin-bottom: 3rem; }
  .games-hero h1,.game-heading h1 { font-size: clamp(3.2rem,8vw,7.5rem); }
  .games-hero__dek,.game-heading__dek {
    color: var(--text-soft); font-family: var(--serif); font-size: clamp(1.1rem,2vw,1.45rem); margin: 1rem 0 0; max-width: 44rem;
  }
  .games-date { border-left: .25rem solid var(--accent); color: var(--text-muted); font-size: .78rem; margin: 0; padding: .6rem 0 .6rem 1rem; }
  .games-date strong { color: var(--text); display: block; font-family: var(--serif); font-size: 1.25rem; margin-bottom: .2rem; }
  .game-grid { border-top: .22rem solid var(--text); display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); }
  .game-card { border-bottom: 1px solid var(--border); border-right: 1px solid var(--border); display: flex; flex-direction: column; min-height: 24rem; padding: clamp(1.25rem,3vw,2.2rem); position: relative; }
  .game-card:last-child { border-right: 0; }
  .game-card__number { color: var(--accent); font-size: .68rem; font-weight: 900; letter-spacing: .15em; text-transform: uppercase; }
  .game-card h2 { font-size: clamp(2rem,4vw,3.4rem); margin-top: 2.5rem; }
  .game-card p { color: var(--text-muted); margin-bottom: 1.8rem; }
  .game-card__action { align-items: center; border-top: 1px solid var(--border); display: flex; font-size: .75rem; font-weight: 900; justify-content: space-between; letter-spacing: .08em; margin-top: auto; padding-top: 1rem; text-decoration: none; text-transform: uppercase; }
  .game-card__status { background: var(--accent-soft); color: var(--accent); display: none; font-size: .62rem; font-weight: 900; letter-spacing: .08em; padding: .35rem .5rem; text-transform: uppercase; }
  .game-card[data-complete="true"] .game-card__status { display: inline-block; }
  .game-card__motif { display: grid; gap: .2rem; grid-template-columns: repeat(5,1fr); margin: 1.4rem 0 0; max-width: 11rem; }
  .game-card__motif i { aspect-ratio: 1; background: var(--border); display: block; }
  .game-card__motif i:nth-child(2),.game-card__motif i:nth-child(4),.game-card__motif i:nth-child(7) { background: var(--game-gold); }
  .game-card__motif--mini i:nth-child(2),.game-card__motif--mini i:nth-child(6),.game-card__motif--mini i:nth-child(8) { background: var(--game-ink); }
  .game-card__motif--sudoku { gap: .12rem; grid-template-columns: repeat(3,1fr); max-width: 5rem; }
  .game-card__motif--sudoku i:nth-child(2n) { background: var(--game-green); }
  .game-card__motif--2048 { gap: .12rem; grid-template-columns: repeat(4,1fr); max-width: 6.5rem; }
  .game-card__motif--2048 i:nth-child(3n),.game-card__motif--2048 i:nth-child(7) { background: var(--accent); }
  .game-card__motif--nonogram { gap: .12rem; grid-template-columns: repeat(5,1fr); max-width: 6.5rem; }
  .game-card__motif--nonogram i:nth-child(2),.game-card__motif--nonogram i:nth-child(6),.game-card__motif--nonogram i:nth-child(8),.game-card__motif--nonogram i:nth-child(12),.game-card__motif--nonogram i:nth-child(14),.game-card__motif--nonogram i:nth-child(18),.game-card__motif--nonogram i:nth-child(22) { background: var(--game-ink); }
  .game-card__motif--mahjong { grid-template-columns: repeat(3,1fr); max-width: 7.5rem; }
  .game-card__motif--mahjong i { align-items: center; background: #f4eedf; border: 1px solid #cdbf9e; border-radius: .18rem; box-shadow: .12rem .16rem 0 #7f9a85; color: #28231d; display: flex; font-size: 1.35rem; justify-content: center; }
  .game-heading { border-bottom: 1px solid var(--border); margin: 0 auto 2rem; max-width: 46rem; padding-bottom: 1.5rem; text-align: center; }
  .game-heading .eyebrow { margin-bottom: .8rem; }
  .game-meta { align-items: center; color: var(--text-muted); display: flex; font-size: .72rem; font-weight: 750; gap: 1rem; justify-content: center; margin-top: 1rem; }
  .game-meta span + span { border-left: 1px solid var(--border); padding-left: 1rem; }
  .game-panel { margin: 0 auto; max-width: 46rem; }
  .game-status { color: var(--text-soft); font-family: var(--serif); min-height: 2.2rem; text-align: center; }
  .game-performance { display: flex; gap: .55rem; justify-content: center; margin: 0 auto 1.2rem; }
  .game-performance p { background: var(--game-ink); color: var(--surface); margin: 0; min-width: 7.25rem; padding: .55rem .9rem; text-align: center; }
  .game-performance span { display: block; font-size: .62rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .game-performance strong { display: block; font-size: 1.25rem; }
  .game-scoring { color: var(--text-muted); font-size: .72rem; margin: -.65rem auto 1.35rem; max-width: 38rem; text-align: center; }
  .game-scoring summary { color: var(--accent); cursor: pointer; font-weight: 850; letter-spacing: .06em; text-transform: uppercase; }
  .game-scoring p { line-height: 1.45; margin: .55rem auto 0; }
  .game-actions { display: flex; flex-wrap: wrap; gap: .65rem; justify-content: center; margin: 1.3rem 0; }
  .game-actions[hidden] { display: none; }
  .game-button {
    background: var(--text); border: 1px solid var(--text); color: var(--surface); cursor: pointer; font-size: .72rem; font-weight: 900; letter-spacing: .08em; min-height: 2.75rem; padding: .7rem 1rem; text-transform: uppercase;
  }
  .game-button--secondary { background: transparent; color: var(--text); }
  .game-button[hidden] { display: none; }
  .game-note { border-top: 1px solid var(--border); color: var(--text-muted); font-size: .75rem; margin: 2.5rem auto 0; max-width: 38rem; padding-top: 1rem; text-align: center; }
  .game-sharing { align-items: start; border-top: .2rem solid var(--text); display: grid; gap: 1.5rem; grid-template-columns: minmax(12rem,.7fr) minmax(18rem,1.3fr); margin: 3.5rem auto 0; max-width: 58rem; padding-top: 1rem; }
  .game-sharing h2 { font-size: 1.35rem; margin: 0 0 .3rem; }
  .game-sharing p { color: var(--text-muted); font-size: .75rem; margin: 0; }
  .game-sharing label { align-items: start; color: var(--text-soft); cursor: pointer; display: grid; font-size: .78rem; gap: .65rem; grid-template-columns: auto 1fr; line-height: 1.45; }
  .game-sharing input { accent-color: var(--accent); height: 1.1rem; margin-top: .1rem; width: 1.1rem; }
  .game-sharing strong { color: var(--text); }

  /* Keep route-specific game styling in this external asset. The governed
     production publisher intentionally removes page-level inline styles. */
  .word-board { display: grid; gap: .34rem; grid-template-columns: repeat(5,1fr); margin: 1rem auto 1.6rem; max-width: 21rem; }
  .word-tile { align-items: center; aspect-ratio: 1; border: 2px solid var(--border-strong); display: flex; font-size: clamp(1.5rem,6vw,2.15rem); font-weight: 900; justify-content: center; text-transform: uppercase; }
  .word-tile[data-filled="true"] { border-color: var(--text); }
  .word-tile[data-result="correct"] { background: #6aaa64; border-color: #6aaa64; color: #fff; }
  .word-tile[data-result="present"] { background: #c9b458; border-color: #c9b458; color: #fff; }
  .word-tile[data-result="absent"] { background: #787c7e; border-color: #787c7e; color: #fff; }
  .word-keyboard { margin: 0 auto; max-width: 40rem; user-select: none; }
  .word-keyboard__row { display: flex; gap: .28rem; justify-content: center; margin-bottom: .32rem; }
  .word-key { background: var(--border); border: 0; border-radius: .2rem; color: var(--text); cursor: pointer; flex: 1 1 0; font-size: clamp(.72rem,2.4vw,1rem); font-weight: 850; height: 3.45rem; max-width: 3.4rem; padding: 0; }
  .word-key--wide { flex-basis: 1.55rem; font-size: .62rem; max-width: 4.5rem; text-transform: uppercase; }
  .word-key[data-result="correct"] { background: #6aaa64; color: #fff; }
  .word-key[data-result="present"] { background: #c9b458; color: #fff; }
  .word-key[data-result="absent"] { background: #787c7e; color: #fff; }

  .mini-layout { display: grid; gap: clamp(2rem,5vw,5rem); grid-template-columns: minmax(18rem,.9fr) minmax(18rem,1.1fr); margin: 0 auto; max-width: 68rem; }
  .mini-layout > * { min-width: 0; }
  .mini-grid { --mini-cols: 7; background: var(--text); border: 3px solid var(--text); box-sizing: border-box; display: grid; grid-template-columns: repeat(var(--mini-cols),minmax(0,1fr)); margin: 1rem auto; max-width: min(34rem,calc(100vw - 2rem)); width: 100%; }
  .mini-cell,.mini-block { aspect-ratio: 1; min-width: 0; }
  .mini-block { background: var(--text); }
  .mini-cell { background: var(--surface); border-bottom: 1px solid var(--text); border-right: 1px solid var(--text); display: block; position: relative; }
  .mini-cell span { color: var(--text); font-size: clamp(.46rem,1.2vw,.66rem); font-weight: 850; left: .14rem; line-height: 1; position: absolute; top: .12rem; z-index: 1; }
  .mini-cell input { background: var(--surface); border: 0; box-sizing: border-box; color: var(--text); font-size: clamp(1rem,3.4vw,1.8rem); font-weight: 850; height: 100%; min-width: 0; padding: .16rem; text-align: center; text-transform: uppercase; width: 100%; }
  .mini-cell[data-in-word] input { background: color-mix(in srgb,var(--accent) 18%,var(--surface)); }
  .mini-cell[data-active] input,.mini-cell input:focus { background: color-mix(in srgb,var(--accent) 42%,var(--surface)); outline: .2rem solid var(--focus); outline-offset: -.2rem; }
  .mini-cell input[aria-invalid="true"] { background: #f7d5d1; color: #7f1813; }
  .mini-current-clue { align-items: baseline; background: var(--game-ink); color: var(--surface); display: grid; gap: .3rem 1rem; grid-template-columns: auto 1fr; margin: .75rem auto 0; max-width: min(34rem,calc(100vw - 2rem)); padding: .7rem .85rem; }
  .mini-current-clue strong { font-size: .72rem; letter-spacing: .05em; text-transform: uppercase; }
  .mini-current-clue span { font-family: var(--serif); line-height: 1.25; }
  .mini-clues { display: grid; gap: 2rem; grid-template-columns: repeat(2,minmax(0,1fr)); }
  .mini-clues h2 { border-top: .18rem solid var(--text); font-size: 1.65rem; padding-top: .55rem; }
  .mini-clues ol { list-style: none; margin: 0; padding: 0; }
  .mini-clues li { border-top: 1px solid var(--border); font-family: var(--serif); line-height: 1.25; }
  .mini-clues button { background: transparent; border: 0; color: var(--text); cursor: pointer; display: grid; font: inherit; gap: .55rem; grid-template-columns: 1.2rem 1fr; line-height: inherit; padding: .7rem .35rem; text-align: left; width: 100%; }
  .mini-clues button:hover,.mini-clues button[aria-current] { background: var(--accent-soft); }
  .mini-clues button:focus-visible { outline: .18rem solid var(--focus); outline-offset: -.18rem; }
  .mini-clues li span { font-family: var(--sans); font-size: .72rem; font-weight: 900; }

  .sudoku-panel { max-width: 42rem; }
  .sudoku-grid { border: 3px solid var(--text); display: grid; grid-template-columns: repeat(9,1fr); margin: 1rem auto 1.2rem; max-width: 34rem; }
  .sudoku-cell { align-items: center; aspect-ratio: 1; background: var(--surface); border: 0; border-bottom: 1px solid var(--border-strong); border-right: 1px solid var(--border-strong); color: var(--accent); cursor: pointer; display: flex; font-size: clamp(1rem,4vw,1.75rem); font-weight: 750; justify-content: center; padding: 0; }
  .sudoku-cell:nth-child(9n) { border-right: 0; }
  .sudoku-cell:nth-child(3n):not(:nth-child(9n)) { border-right: 3px solid var(--text); }
  .sudoku-cell:nth-child(n+19):nth-child(-n+27),.sudoku-cell:nth-child(n+46):nth-child(-n+54) { border-bottom: 3px solid var(--text); }
  .sudoku-cell:nth-child(n+73) { border-bottom: 0; }
  .sudoku-cell--given { color: var(--text); cursor: default; font-weight: 900; }
  .sudoku-cell[aria-selected="true"] { background: var(--accent-soft); outline: .18rem solid var(--focus); outline-offset: -.18rem; }
  .sudoku-cell[aria-invalid="true"] { background: #f7d5d1; color: #7f1813; }
  .sudoku-pad { display: grid; gap: .35rem; grid-template-columns: repeat(10,1fr); margin: 0 auto; max-width: 34rem; }
  .sudoku-pad button { background: var(--border); border: 0; color: var(--text); cursor: pointer; font-size: 1rem; font-weight: 850; min-height: 2.8rem; }
  .sudoku-difficulty { align-items: center; border: 1px solid var(--text); display: flex; font-size: .68rem; font-weight: 900; gap: .5rem; letter-spacing: .06em; padding: .45rem .65rem; text-transform: uppercase; }
  .sudoku-difficulty select { background: var(--surface); border: 0; color: var(--text); font: inherit; min-height: 1.8rem; }
  .twenty48-panel { max-width: 36rem; }
  .twenty48-scoreboard { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center; margin: 0 auto .5rem; }
  .twenty48-scoreboard p { background: var(--game-ink); color: var(--surface); margin: 0; min-width: 6.5rem; padding: .55rem .8rem; text-align: center; }
  .twenty48-scoreboard span { display: block; font-size: .62rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .twenty48-scoreboard strong { display: block; font-size: 1.25rem; }
  .twenty48-grid { background: #9a8f83; border: .5rem solid #9a8f83; border-radius: .35rem; display: grid; gap: .5rem; grid-template-columns: repeat(4,1fr); margin: 1rem auto; max-width: 31rem; position: relative; touch-action: none; user-select: none; }
  .twenty48-tile { align-items: center; aspect-ratio: 1; background: #c9c0b5; border-radius: .2rem; color: #3d352e; display: flex; font-size: clamp(1.35rem,6vw,2.6rem); font-weight: 900; justify-content: center; line-height: 1; transform: scale(1); }
  .twenty48-motion { box-sizing: border-box; pointer-events: none; position: absolute; transition: transform 125ms cubic-bezier(.2,.75,.25,1); z-index: 2; }
  .twenty48-grid.is-animating > .twenty48-tile:not(.twenty48-motion) { background: #c9c0b5 !important; color: transparent !important; }
  .twenty48-tile.is-new { animation: twenty48-appear 180ms cubic-bezier(.2,.8,.2,1); }
  .twenty48-tile.is-merged { animation: twenty48-pop 220ms cubic-bezier(.2,.8,.2,1); position: relative; z-index: 1; }
  [data-2048-score].is-bumped { animation: twenty48-score 220ms ease-out; }
  @keyframes twenty48-appear { from { opacity: 0; transform: scale(.35); } 70% { opacity: 1; transform: scale(1.08); } to { transform: scale(1); } }
  @keyframes twenty48-pop { 50% { filter: brightness(1.12); transform: scale(1.16); } }
  @keyframes twenty48-score { 50% { color: var(--accent); transform: translateY(-.08rem) scale(1.12); } }
  .twenty48-tile[data-value="2"] { background: #eee7dc; }
  .twenty48-tile[data-value="4"] { background: #e9dfc9; }
  .twenty48-tile[data-value="8"] { background: #d98248; color: #fff; }
  .twenty48-tile[data-value="16"] { background: #cf673c; color: #fff; }
  .twenty48-tile[data-value="32"] { background: #c94c37; color: #fff; }
  .twenty48-tile[data-value="64"] { background: #b93828; color: #fff; }
  .twenty48-tile[data-value="128"],.twenty48-tile[data-value="256"],.twenty48-tile[data-value="512"] { background: var(--game-gold); color: #fff; font-size: clamp(1.1rem,5vw,2.1rem); }
  .twenty48-tile[data-value="1024"],.twenty48-tile[data-value="2048"],.twenty48-tile[data-value="4096+"] { background: var(--game-green); color: #fff; font-size: clamp(.9rem,4.3vw,1.85rem); }
  .twenty48-controls { display: grid; gap: .35rem; grid-template-columns: repeat(4,3.25rem); justify-content: center; }
  .twenty48-controls button { background: var(--border); border: 1px solid var(--border-strong); color: var(--text); cursor: pointer; font-size: 1.4rem; min-height: 3.25rem; }
  .twenty48-controls button:focus-visible { outline: .2rem solid var(--focus); outline-offset: .1rem; }
  @media (prefers-reduced-motion: reduce) { .twenty48-motion { transition: none; } .twenty48-tile.is-new,.twenty48-tile.is-merged,[data-2048-score].is-bumped { animation: none; } }
  .mahjong-panel { margin: 0 auto; max-width: 72rem; perspective: 80rem; }
  .mahjong-board { aspect-ratio: 1.48; background: radial-gradient(ellipse at 48% 28%,#397a5d 0%,#174731 68%,#103624 100%); border: .55rem solid #123a29; border-bottom-color: #08271b; border-bottom-width: .95rem; border-radius: .45rem; box-shadow: inset 0 0 2.6rem rgb(0 0 0 / .34),0 1.05rem 0 #071f16,0 1.8rem 2.8rem rgb(0 0 0 / .5); isolation: isolate; margin: 1rem auto 3.6rem; max-width: 68rem; overflow: hidden; position: relative; transform: perspective(80rem) rotateX(10deg) rotateZ(-.5deg); transform-origin: 50% 100%; width: 100%; }
  .mahjong-board::before { background: linear-gradient(90deg,transparent,rgb(255 255 255 / .1),transparent); content:""; height: 1px; left: 8%; pointer-events: none; position: absolute; right: 8%; top: 5%; }
  .mahjong-tile { --tile-edge:#809985; --tile-edge-dark:#5b7461; align-items: center; background: linear-gradient(145deg,#fffdf6 0%,#f4ead3 76%,#ded0b2 100%); border: 1px solid #b8a67e; border-radius: clamp(.18rem,.42vw,.36rem); box-shadow: inset .08rem .08rem 0 rgb(255 255 255 / .92),0 .12rem .15rem rgb(0 0 0 / .24); color: #25201a; cursor: pointer; display: flex; font-family:"Apple Symbols","Noto Sans Symbols 2","Segoe UI Symbol",sans-serif; font-size: clamp(1.05rem,3.5vw,2.9rem); height: 10.6%; justify-content: center; left: calc(3.6% + var(--mahjong-x) * 3.05% + var(--mahjong-z) * .72%); line-height: 1; padding: 0 0 .08em; position: absolute; top: calc(5.5% + var(--mahjong-y) * 5.5% - var(--mahjong-z) * 2.25%); transition: filter 110ms ease,transform 110ms ease; width: 6.1%; }
  .mahjong-tile::before,.mahjong-tile::after { content:""; pointer-events:none; position:absolute; }
  .mahjong-tile::before { background: linear-gradient(180deg,var(--tile-edge),var(--tile-edge-dark)); border-radius: 0 .15rem .15rem 0; height: calc(100% - .08rem); left: calc(100% - .02rem); top: .24rem; transform: skewY(39deg); transform-origin: 0 0; width: clamp(.22rem,.58vw,.48rem); }
  .mahjong-tile::after { background: linear-gradient(90deg,var(--tile-edge),var(--tile-edge-dark)); border-radius: 0 0 .15rem .15rem; height: clamp(.22rem,.58vw,.48rem); left: .25rem; top: calc(100% - .02rem); transform: skewX(51deg); transform-origin: 0 0; width: calc(100% - .06rem); }
  .mahjong-tile__face { position:relative; text-shadow:0 1px 0 #fff; transform:translate(-.03em,-.03em); z-index:2; }
  .mahjong-tile[data-family="character"],.mahjong-tile[data-family="dragon"] { color:#9d302d; }
  .mahjong-tile[data-family="bamboo"],.mahjong-tile[data-family="flower"] { color:#276744; }
  .mahjong-tile[data-family="circle"],.mahjong-tile[data-family="season"] { color:#245983; }
  .mahjong-tile[data-elevation="2"],.mahjong-tile[data-elevation="3"],.mahjong-tile[data-elevation="4"] { --tile-edge:#91a994; --tile-edge-dark:#566e5c; }
  .mahjong-tile:not(:disabled):hover { filter:brightness(1.1) drop-shadow(0 .35rem .25rem rgb(0 0 0 / .32)); transform:translate(-.08rem,-.2rem); }
  .mahjong-tile:disabled { cursor:default; filter:saturate(.68) brightness(.9); }
  .mahjong-tile[data-selected="true"],.mahjong-tile[data-hinted="true"] { --tile-edge:#b08b2d; --tile-edge-dark:#775b18; background:linear-gradient(145deg,#fff3a8,#e4b947 78%,#c39125); }
  .mahjong-tile[data-selected="true"] { outline:.18rem solid #fff; outline-offset:-.13rem; transform:translate(-.08rem,-.2rem); }
  .mahjong-tile[data-hinted="true"] { animation:mahjong-hint 760ms ease-in-out infinite alternate; }
  .mahjong-tile:focus-visible { outline:.22rem solid #fff; outline-offset:.16rem; }
  @keyframes mahjong-hint { to { filter:brightness(1.13) drop-shadow(0 0 .4rem #f5d36b); transform:translate(-.06rem,-.18rem); } }
  .tatham-host { margin: 0 auto; max-width: 58rem; }
