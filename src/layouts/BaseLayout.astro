---
import SiteHeader from "../components/SiteHeader.astro";
import { jsonForHtml } from "../lib/json-for-html.mjs";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  image?: string;
  articleType?: string;
  publishedAt?: string;
  updatedAt?: string;
}

const {
  title, description, canonical = new URL(Astro.url.pathname, Astro.site),
  noindex = false, image, articleType = "website", publishedAt, updatedAt
} = Astro.props;
const candidatePreview = import.meta.env.BOHONEWS_PREVIEW === "1";
const socialImage = new URL(image ?? "/og.png", Astro.site);
const siteGraph = {
  "@context":"https://schema.org",
  "@graph":[
    {"@type":"Organization","@id":"https://bohonews.com/#organization",name:"Boho News",url:"https://bohonews.com"},
    {"@type":"WebSite","@id":"https://bohonews.com/#website",url:"https://bohonews.com",name:"Boho News",
      publisher:{"@id":"https://bohonews.com/#organization"},
      potentialAction:{"@type":"SearchAction",target:{"@type":"EntryPoint",urlTemplate:"https://bohonews.com/search/?q={search_term_string}"},"query-input":"required name=search_term_string"}}
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f3efe6" />
    <link rel="canonical" href={canonical} />
    {(candidatePreview || noindex) && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content={articleType} />
    <meta property="og:site_name" content="Boho News" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={jsonForHtml(siteGraph)} />
    <script is:inline src="/theme.js"></script>
    {!candidatePreview && <script is:inline type="module" src="https://widgets.tradingview-widget.com/w/en/tv-ticker-tape.js"></script>}
    {!candidatePreview && <script
      is:inline
      src="/analytics-bootstrap.js"
      data-umami-script-url="https://analytics.bohodigitalservices.com/script.js"
      data-umami-website-id="da60f9a9-f65b-4849-a55d-f9b4365f509d"
      data-umami-domains="bohonews.com,www.bohonews.com"
      data-ga-id="G-76CPXCF9NV"
      data-ga-public-hosts="bohonews.com,www.bohonews.com"
    ></script>}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-brand"><a class="brand" href="/"><span>BOHO</span> NEWS</a><p>One newsroom. Every major desk.</p></div>
      <nav aria-label="Section navigation">
        <p>News</p>
        <a href="/latest/">Latest</a><a href="/us/">U.S.</a><a href="/world/">World</a>
        <a href="/business/">Business</a><a href="/weather-climate/">Weather</a>
      </nav>
      <nav aria-label="Format navigation">
        <p>Formats</p>
        <a href="/live/">Live</a><a href="/investigations/">Investigations</a>
        <a href="/visuals/">Visuals</a><a href="/documents/">Documents</a><a href="/data/">Data</a>
        <a href="/evidence/">Evidence Library</a>
      </nav>
      <nav aria-label="Policy navigation">
        <p>Boho News</p>
        <a href="/about/">About</a><a href="/corrections/">Corrections</a>
        <a href="/editorial-standards/">Standards</a><a href="/contact/">Contact</a>
        <a href="/support/">Support</a><a href="/accessibility/">Accessibility</a>
        <a href="/privacy/">Privacy</a><a href="/terms/">Terms</a>
      </nav>
    </footer>
  </body>
</html>
