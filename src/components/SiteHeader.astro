---
const links = [
  ["Latest", "/latest-news/"],
  ["Politics", "/politics/"],
  ["White House", "/white-house/"],
  ["Congress", "/congress/"],
  ["Courts", "/courts/"],
  ["Elections", "/elections/"],
  ["Investigations", "/investigations/"],
  ["Explainers", "/explainers/"],
  ["Opinion", "/opinion/"],
  ["Search", "/search/"]
];
---

<header class="site-header">
  <div class="masthead">
    <a class="brand" href="/" aria-label="Boho News home">BOHO<span>NEWS</span></a>
    <p class="shell-label">Newsroom infrastructure preview</p>
  </div>
  <div class="nav-scroll">
    <nav aria-label="Primary navigation">
      <ul>{links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
    </nav>
  </div>
</header>
