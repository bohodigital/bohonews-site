---
import GameGuide from "./GameGuide.astro";
import GamesLayout from "../../layouts/GamesLayout.astro";

interface Props { kind: "freecell" | "spider" | "pyramid" | "tripeaks"; }
const { kind } = Astro.props;
const copy = {
  freecell: { title:"FreeCell", eyebrow:"Open-information Solitaire", dek:"Every card is visible. Use four free cells to build all four suits from Ace through King.", intro:"Build foundations by suit while arranging the tableau downward in alternating colors. Empty cells temporarily hold one card.", score:"A win earns an 8,500-point base, a time bonus, and an efficiency bonus. Hints subtract 350 points.", note:"Standard FreeCell supermoves are limited by the number of open cells and empty columns." },
  spider: { title:"Spider Solitaire", eyebrow:"Two-deck Solitaire", dek:"Build suited King-to-Ace runs across ten columns in one-, two-, or four-suit difficulty.", intro:"Arrange cards downward regardless of suit, but only a fully suited descending run can move together or leave the table.", score:"A win earns a difficulty-scaled base and time bonus. Four suits pays 2.4×; hints subtract 450 points.", note:"Canonical Spider uses 104 cards. A stock row can be dealt only when every column contains a card." },
  pyramid: { title:"Pyramid Solitaire", eyebrow:"Pairs make thirteen", dek:"Clear the pyramid by removing exposed Kings and exposed pairs whose ranks total thirteen.", intro:"Only uncovered cards may be played. Kings leave alone; all other cards leave in pairs totaling thirteen.", score:"A win earns a 5,500-point base, a time bonus, and removal points. Hints subtract 250 points.", note:"This traditional one-pass version does not recycle the stock." },
  tripeaks: { title:"TriPeaks Solitaire", eyebrow:"Build the longest run", dek:"Clear three peaks by playing exposed cards one rank above or below the waste card.", intro:"Choose any uncovered card exactly one rank higher or lower than the waste. Long runs score increasingly well.", score:"A win earns a 6,000-point base, a time bonus, removal points, and a best-streak bonus. Hints subtract 250 points.", note:"Ace connects to 2 and King connects to Queen; Ace and King do not wrap in this ruleset." }
}[kind];
---

<GamesLayout title={copy.title} description={`Play unlimited ${copy.title} free in your browser on Boho News.`} game={copy.title}>
  <header class="game-heading card-suite-heading">
    <p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p class="game-heading__dek">{copy.dek}</p>
    <div class="game-meta"><span data-card-number>Deal 1</span><span data-card-stats>0 solved</span><span data-card-mode>{kind === "spider" ? "1 suit" : "Standard"}</span></div>
  </header>

  <GameGuide game={kind} title={`How ${copy.title} works`} intro={copy.intro}>
    <figure class={`game-guide__visual card-suite-guide card-suite-guide--${kind}`}>
      {kind === "freecell" && <><div><span class="solitaire-guide__card is-black">8♣</span><span>←</span><span class="solitaire-guide__card is-red">7♥</span></div><figcaption>Descend while alternating colors. Each empty free cell holds one card.</figcaption></>}
      {kind === "spider" && <><div><span class="solitaire-guide__card is-black">K♠</span><span class="solitaire-guide__card is-black">Q♠</span><span class="solitaire-guide__card is-black">J♠</span></div><figcaption>Complete a same-suit King-to-Ace run to remove all thirteen cards.</figcaption></>}
      {kind === "pyramid" && <><div><span class="solitaire-guide__card is-red">5♥</span><strong>+</strong><span class="solitaire-guide__card is-black">8♣</span><strong>= 13</strong></div><figcaption>Jack counts 11, Queen 12, and King 13. Remove an exposed King by itself.</figcaption></>}
      {kind === "tripeaks" && <><div><span class="solitaire-guide__card is-black">6♣</span><span>→</span><span class="solitaire-guide__card is-red">7♥</span><span>→</span><span class="solitaire-guide__card is-black">8♠</span></div><figcaption>Keep the run alive without drawing to multiply the value of each card.</figcaption></>}
    </figure>
    <ol class="game-guide__steps">
      <li><strong>Play:</strong> tap a card, then its destination. FreeCell and Spider also support dragging.</li>
      <li><strong>Stock:</strong> press Space or tap the deck in Spider, Pyramid, and TriPeaks.</li>
      <li><strong>Help:</strong> H shows a legal move, Z undoes, and N offers a fresh deal.</li>
      <li><strong>Goal:</strong> {kind === "spider" ? "remove all eight suited runs" : kind === "pyramid" || kind === "tripeaks" ? "remove every card from the layout" : "move all 52 cards to the foundations"}.</li>
    </ol>
  </GameGuide>

  <section class={`card-suite-panel card-suite-panel--${kind}`} data-card-suite data-kind={kind} aria-label={`${copy.title} card game`}>
    <div class="game-performance"><p><span>Time</span><strong data-game-time>0:00</strong></p><p><span>Points</span><strong data-game-points>—</strong></p><p><span>{kind === "tripeaks" ? "Streak" : kind === "spider" ? "Runs" : "Moves"}</span><strong data-card-counter>0</strong></p></div>
    <details class="game-scoring"><summary>How scoring works</summary><p>{copy.score}</p></details>
    <p class="game-status" role="status" aria-live="polite" data-card-status>{kind === "freecell" ? "Select any face-up card or legal stack." : kind === "spider" ? "Build downward; matching suits move together." : kind === "pyramid" ? "Find an exposed King or a pair totaling thirteen." : "Play one rank above or below the waste card."}</p>
    <div class={`card-suite-board card-suite-board--${kind}`} data-card-board></div>
    <div class="card-suite-toolbar">
      {kind === "spider" && <label>Difficulty<select data-card-mode-select><option value="1">1 suit</option><option value="2">2 suits</option><option value="4">4 suits</option></select></label>}
      <button class="game-button game-button--secondary" type="button" data-card-hint>Hint</button>
      <button class="game-button game-button--secondary" type="button" data-card-undo disabled>Undo</button>
      <button class="game-button" type="button" data-card-new>New deal</button>
    </div>
  </section>
  <p class="game-note">{copy.note} Progress, undo history, timer, and scores stay in this browser.</p>
</GamesLayout>

<script>
  // @ts-nocheck -- DOM branches are guarded by the page's fixed game kind.
  import { attachGamePerformance } from "../../lib/games/performance";
  import { showGameCelebration } from "../../lib/games/celebration";
  import { confirmProgressLoss } from "../../lib/games/confirm-reset";
  import { pointsBucket, freeCellPoints, spiderPoints, pyramidPoints, triPeaksPoints } from "../../lib/games/scoring";
  import { KLONDIKE_SUITS, klondikeCardColor, klondikeRankLabel, klondikeSuitSymbol } from "../../lib/games/solitaire";
  import { createFreeCellGame, createSpiderGame, createPyramidGame, createTriPeaksGame, moveFreeCell, freeCellHint, moveSpider, dealSpiderStock, spiderHint, pyramidExposed, removePyramid, drawPyramid, pyramidHint, triPeaksExposed, playTriPeaks, drawTriPeaks, triPeaksHint } from "../../lib/games/card-suite";

  const root=document.querySelector("[data-card-suite]");
  if(root){
    const kind=root.dataset.kind;const board=root.querySelector("[data-card-board]");const status=root.querySelector("[data-card-status]");const modeSelect=root.querySelector("[data-card-mode-select]");const STORAGE_KEY="boho-games:v2";
    let store=readStore();let state=valid(store[kind]?.current)?store[kind].current:null;let selected=null;let hinted=null;let performanceTracker=null;
    const TRI_POS=[[2,0],[5,0],[8,0],[1.5,1],[2.5,1],[4.5,1],[5.5,1],[7.5,1],[8.5,1],[1,2],[2,2],[3,2],[4,2],[5,2],[6,2],[7,2],[8,2],[9,2],[.5,3],[1.5,3],[2.5,3],[3.5,3],[4.5,3],[5.5,3],[6.5,3],[7.5,3],[8.5,3],[9.5,3]];
    function readStore(){try{const value=JSON.parse(localStorage.getItem(STORAGE_KEY)||"{}");return value&&typeof value==="object"&&!Array.isArray(value)?value:{};}catch{return {};}}
    function stats(){const value=store[kind]?.stats;return {solved:Number.isInteger(value?.solved)&&value.solved>=0?value.solved:0,best:Number.isFinite(value?.best)&&value.best>=0?value.best:0};}
    function valid(value){if(!value||value.format!==`${kind}-v1`||!value.game||!Array.isArray(value.history)||value.history.length>80||!Number.isInteger(value.number)||value.number<1||!Number.isInteger(value.hints)||value.hints<0)return false;const game=value.game;if(kind==="freecell")return Array.isArray(game.tableau)&&game.tableau.length===8&&Array.isArray(game.cells)&&game.cells.length===4;if(kind==="spider")return Array.isArray(game.tableau)&&game.tableau.length===10&&Array.isArray(game.stock)&&[1,2,4].includes(game.suitCount);return Array.isArray(game.tableau)&&game.tableau.length===28&&Array.isArray(game.stock)&&Array.isArray(game.waste);}
    function create(mode){return kind==="freecell"?createFreeCellGame():kind==="spider"?createSpiderGame(Math.random,mode||1):kind==="pyramid"?createPyramidGame():createTriPeaksGame();}
    function fresh(mode=kind==="spider"?Number(modeSelect?.value)||1:null){const number=(Number.isInteger(store[kind]?.sequence)?store[kind].sequence:0)+1;state={format:`${kind}-v1`,number,game:create(mode),history:[],hints:0,complete:false,recorded:false,reported:false,points:null};selected=null;hinted=null;store[kind]={...(store[kind]||{}),sequence:number,current:state,stats:stats()};save();performanceTracker?.reset();render();}
    function save(){store[kind]={...(store[kind]||{}),current:{...state,history:state.history.slice(-80)},stats:stats()};try{localStorage.setItem(STORAGE_KEY,JSON.stringify(store));}catch{}}
    if(!state)fresh();
    const deep=(value)=>structuredClone(value);
    function cardName(card){return `${card.rank===1?"Ace":card.rank===11?"Jack":card.rank===12?"Queen":card.rank===13?"King":card.rank} of ${card.suit}`;}
    function cardNode(card,source,stackIndex=0){const button=document.createElement("button");button.type="button";button.className=`solitaire-card ${card.faceUp!==false?"is-face":"is-back"}`;button.dataset.cardSource=JSON.stringify(source);button.dataset.cardId=card.id;button.dataset.color=klondikeCardColor(card);button.style.setProperty("--card-index",String(stackIndex));button.disabled=card.faceUp===false||state.complete;button.draggable=card.faceUp!==false&&!state.complete;button.setAttribute("aria-label",card.faceUp===false?"Face-down card":cardName(card));if(card.faceUp!==false){button.innerHTML=`<span class="solitaire-card__rank">${klondikeRankLabel(card.rank)}</span><span class="solitaire-card__suit">${klondikeSuitSymbol(card.suit)}</span>`;}if(selected&&JSON.stringify(selected)===JSON.stringify(source))button.classList.add("is-selected");if(hinted?.source&&JSON.stringify(hinted.source)===JSON.stringify(source))button.classList.add("is-hinted");return button;}
    function slot(label,target,symbol=""){const button=document.createElement("button");button.type="button";button.className="solitaire-slot card-suite-slot";button.setAttribute("aria-label",label);button.textContent=symbol;if(target)button.dataset.cardTarget=JSON.stringify(target);return button;}
    function topRow(){const row=document.createElement("div");row.className="card-suite-top";return row;}
    function renderFreeCell(){const top=topRow();for(let index=0;index<4;index++){const card=state.game.cells[index];top.append(card?cardNode(card,{zone:"cell",index}):slot(`Empty free cell ${index+1}`,{zone:"cell",index},"FREE"));}const spacer=document.createElement("i");spacer.className="card-suite-spacer";top.append(spacer);for(const suit of KLONDIKE_SUITS){const card=state.game.foundations[suit].at(-1);const node=card?cardNode(card,{zone:"foundation",suit}):slot(`Empty ${suit} foundation`,{zone:"foundation",suit},klondikeSuitSymbol(suit));node.dataset.cardTarget=JSON.stringify({zone:"foundation",suit});top.append(node);}board.append(top,columns(state.game.tableau,"freecell"));}
    function columns(piles,type){const columns=document.createElement("div");columns.className=`card-suite-columns card-suite-columns--${type}`;piles.forEach((pile,pileIndex)=>{const column=document.createElement("div");column.className="card-suite-column";column.dataset.cardTarget=JSON.stringify(type==="freecell"?{zone:"tableau",pile:pileIndex}:{pile:pileIndex});column.setAttribute("aria-label",`Column ${pileIndex+1}`);pile.forEach((card,index)=>column.append(cardNode(card,type==="freecell"?{zone:"tableau",pile:pileIndex,index}:{pile:pileIndex,index},index)));if(!pile.length)column.append(slot("Empty column",type==="freecell"?{zone:"tableau",pile:pileIndex}:{pile:pileIndex},""));columns.append(column);});return columns;}
    function renderSpider(){const top=topRow();const stock=slot(state.game.stock.length?`Stock, ${state.game.stock.length} cards`:"Empty stock",{draw:true},state.game.stock.length?"BN":"");stock.classList.toggle("is-back",Boolean(state.game.stock.length));stock.innerHTML+=`<small>${state.game.stock.length/10}</small>`;top.append(stock);const runs=slot(`${state.game.completed.length} of 8 runs completed`,null,"RUNS");runs.innerHTML+=`<small>${state.game.completed.length}/8</small>`;top.append(runs);board.append(top,columns(state.game.tableau,"spider"));}
    function renderPyramid(){const layout=document.createElement("div");layout.className="pyramid-layout";let index=0;for(let row=0;row<7;row++){const line=document.createElement("div");line.className="pyramid-row";for(let column=0;column<=row;column++,index++){const card=state.game.tableau[index];const exposed=card&&pyramidExposed(state.game,index);const node=card?cardNode(card,{zone:"tableau",index}):slot("Removed card",null,"");node.classList.toggle("is-covered",Boolean(card&&!exposed));if(card&&!exposed)node.disabled=true;line.append(node);}layout.append(line);}board.append(layout,drawArea("pyramid"));}
    function renderTriPeaks(){const layout=document.createElement("div");layout.className="tripeaks-layout";state.game.tableau.forEach((card,index)=>{if(!card)return;const exposed=triPeaksExposed(state.game,index);const node=cardNode({...card,faceUp:exposed},{zone:"tableau",index});node.style.setProperty("--x",String(TRI_POS[index][0]));node.style.setProperty("--y",String(TRI_POS[index][1]));node.classList.toggle("is-covered",!exposed);if(!exposed)node.disabled=true;layout.append(node);});board.append(layout,drawArea("tripeaks"));}
    function drawArea(type){const area=document.createElement("div");area.className="card-suite-draw";const stock=slot(state.game.stock.length?`Stock, ${state.game.stock.length} cards`:"Empty stock",{draw:true},state.game.stock.length?"BN":"");stock.classList.toggle("is-back",Boolean(state.game.stock.length));stock.innerHTML+=`<small>${state.game.stock.length}</small>`;const waste=state.game.waste.at(-1);const wasteNode=waste?cardNode(waste,{zone:"waste"}):slot("Empty waste",null,"W");area.append(stock,wasteNode);return area;}
    function render(){board.replaceChildren();if(kind==="freecell")renderFreeCell();else if(kind==="spider")renderSpider();else if(kind==="pyramid")renderPyramid();else renderTriPeaks();root.querySelector("[data-card-undo]").disabled=!state.history.length||state.complete;root.querySelector("[data-card-hint]").disabled=state.complete;document.querySelector("[data-card-number]").textContent=`Deal ${state.number}`;document.querySelector("[data-card-stats]").textContent=`${stats().solved} solved · best ${stats().best?stats().best.toLocaleString():"—"}`;const mode=kind==="spider"?`${state.game.suitCount} suit${state.game.suitCount===1?"":"s"}`:"Standard";document.querySelector("[data-card-mode]").textContent=mode;if(modeSelect)modeSelect.value=String(state.game.suitCount);root.querySelector("[data-card-counter]").textContent=String(kind==="tripeaks"?state.game.streak:kind==="spider"?`${state.game.completed.length}/8`:state.game.moves);performanceTracker?.render();}
    function commit(result,message="Move made."){if(!result?.moved){status.textContent="That move is not legal here.";return false;}state.history.push(deep(state.game));state.history=state.history.slice(-80);state.game=result.state;state.complete=Boolean(state.game.complete);selected=null;hinted=null;status.textContent=message;save();render();if(state.complete)finish();return true;}
    function sourceCard(source){if(kind==="freecell")return source.zone==="cell"?state.game.cells[source.index]:source.zone==="foundation"?state.game.foundations[source.suit].at(-1):state.game.tableau[source.pile]?.[source.index];return state.game.tableau[source.pile]?.[source.index];}
    function choose(source){if(kind==="pyramid"){const card=source.zone==="waste"?state.game.waste.at(-1):state.game.tableau[source.index];if(card?.rank===13&&commit(removePyramid(state.game,source),"King removed."))return;if(selected&&commit(removePyramid(state.game,selected,source),"Pair removed."))return;selected=JSON.stringify(selected)===JSON.stringify(source)?null:source;status.textContent=selected?"Card selected. Choose its partner.":"Selection cleared.";render();return;}if(kind==="tripeaks"){commit(playTriPeaks(state.game,source.index),"Run extended.");return;}selected=JSON.stringify(selected)===JSON.stringify(source)?null:source;status.textContent=selected?"Card or stack selected. Choose a destination.":"Selection cleared.";render();}
    function target(target){if(!selected)return false;const result=kind==="freecell"?moveFreeCell(state.game,selected,target):moveSpider(state.game,selected.pile,selected.index,target.pile);return commit(result);}
    function draw(){if(kind==="freecell")return;commit(kind==="spider"?dealSpiderStock(state.game):kind==="pyramid"?drawPyramid(state.game):drawTriPeaks(state.game),kind==="spider"?"Dealt one card to every column.":"Drew from the stock.");}
    function hint(){const value=kind==="freecell"?freeCellHint(state.game):kind==="spider"?spiderHint(state.game):kind==="pyramid"?pyramidHint(state.game):triPeaksHint(state.game);state.hints++;selected=null;if(!value)status.textContent="No legal move is available.";else if("draw" in value){hinted={draw:true};status.textContent="Hint: draw from the stock.";}else if(kind==="pyramid"){hinted={source:value[0],target:value[1]};status.textContent=value.length===1?"An exposed King is glowing.":"A pair totaling thirteen is glowing.";}else if(kind==="tripeaks"){hinted={source:{zone:"tableau",index:value}};status.textContent="A playable card is glowing.";}else if(kind==="spider"){hinted={source:{pile:value.sourcePile,index:value.sourceIndex},target:{pile:value.targetPile}};status.textContent="A legal run is glowing.";}else{hinted=value;status.textContent="A legal move is glowing.";}save();render();}
    function undo(){if(!state.history.length||state.complete)return;state.game=state.history.pop();state.complete=false;selected=null;hinted=null;save();status.textContent="Last move undone.";render();}
    function calculate(elapsedMs){return kind==="freecell"?freeCellPoints({won:state.complete,moves:state.game.moves,elapsedMs,hints:state.hints}):kind==="spider"?spiderPoints({won:state.complete,suits:state.game.suitCount,moveScore:state.game.score,elapsedMs,hints:state.hints}):kind==="pyramid"?pyramidPoints({won:state.complete,moveScore:state.game.score,elapsedMs,hints:state.hints}):triPeaksPoints({won:state.complete,moveScore:state.game.score,bestStreak:state.game.bestStreak,elapsedMs,hints:state.hints});}
    function finish(){performanceTracker.finish();state.points=calculate(state.timer?.finishedMs||0);if(!state.recorded){const value=stats();value.solved++;value.best=Math.max(value.best,state.points||0);store[kind].stats=value;state.recorded=true;}save();status.textContent=`You cleared ${kind==="spider"?"all eight runs":"the table"}. Beautiful.`;render();const names={freecell:"FreeCell",spider:"Spider",pyramid:"Pyramid",tripeaks:"TriPeaks"};showGameCelebration({title:`${names[kind]} conquered!`,message:`You cleared the table for ${(state.points||0).toLocaleString()} points. The cards never stood a chance.`});if(!state.reported)void window.BohoGameStats?.submit({game:kind,variant:kind==="spider"?`${state.game.suitCount}-suit`:"standard",outcome:"solved",scoreBucket:pointsBucket(state.points||0)}).then((ok)=>{if(ok){state.reported=true;save();}});}
    function newDeal(mode=kind==="spider"?state.game.suitCount:null){if(confirmProgressLoss({complete:state.complete,hasProgress:state.game.moves>0||state.history.length>0,label:`start a new ${kind} deal`}))fresh(mode);else if(modeSelect)modeSelect.value=String(state.game.suitCount);}
    board.addEventListener("click",(event)=>{const targetNode=event.target.closest("[data-card-target]");const sourceNode=event.target.closest("[data-card-source]");if(targetNode){const value=JSON.parse(targetNode.dataset.cardTarget);if(value.draw){draw();return;}if(selected){target(value);return;}}if(sourceNode){const source=JSON.parse(sourceNode.dataset.cardSource);if(selected&&(kind==="freecell"||kind==="spider")){const destination=kind==="freecell"?(source.zone==="tableau"?{zone:"tableau",pile:source.pile}:source.zone==="cell"?{zone:"cell",index:source.index}:{zone:"foundation",suit:source.suit}):{pile:source.pile};if(target(destination))return;}choose(source);}});
    board.addEventListener("dblclick",(event)=>{if(kind!=="freecell")return;const node=event.target.closest("[data-card-source]");if(!node)return;const source=JSON.parse(node.dataset.cardSource);const card=sourceCard(source);if(card)commit(moveFreeCell(state.game,source,{zone:"foundation",suit:card.suit}),"Moved to foundation.");});
    let drag=null;board.addEventListener("dragstart",(event)=>{const node=event.target.closest("[data-card-source]");drag=node?JSON.parse(node.dataset.cardSource):null;if(!drag)event.preventDefault();});board.addEventListener("dragover",(event)=>{if(drag&&event.target.closest("[data-card-target]"))event.preventDefault();});board.addEventListener("drop",(event)=>{event.preventDefault();const node=event.target.closest("[data-card-target]");if(drag&&node){selected=drag;target(JSON.parse(node.dataset.cardTarget));}drag=null;});
    root.querySelector("[data-card-hint]")?.addEventListener("click",hint);root.querySelector("[data-card-undo]")?.addEventListener("click",undo);root.querySelector("[data-card-new]")?.addEventListener("click",()=>newDeal());modeSelect?.addEventListener("change",()=>newDeal(Number(modeSelect.value)));
    document.addEventListener("keydown",(event)=>{if(event.metaKey||event.ctrlKey||event.altKey||/INPUT|SELECT|TEXTAREA/.test(event.target?.tagName||""))return;if(event.key===" "&&kind!=="freecell"){event.preventDefault();draw();}else if(event.key.toLowerCase()==="h")hint();else if(event.key.toLowerCase()==="z")undo();else if(event.key.toLowerCase()==="n")newDeal();else if(event.key==="Escape"){selected=null;hinted=null;render();}});
    document.addEventListener("boho-game-guide-open",(event)=>{if(event.detail?.game===kind)performanceTracker?.pause();});document.addEventListener("boho-game-guide-close",(event)=>{if(event.detail?.game===kind)performanceTracker?.resume();});
    performanceTracker=attachGamePerformance(document,{getState:()=>state,save,calculatePoints:calculate});render();
  }
</script>
