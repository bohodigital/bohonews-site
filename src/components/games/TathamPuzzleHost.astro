---
interface Props {
  asset: "pattern" | "mines" | "loopy";
  label: string;
}

const { asset, label } = Astro.props;
const pin = "3c3632259d298ab62aafa8a5858823569ab1af46";
const scriptSource = `/vendor/tatham/${pin}/${asset}.js`;
const primaryMode = asset === "loopy" ? "Draw line" : asset === "mines" ? "Reveal" : "Fill";
const secondaryMode = asset === "loopy" ? "Exclude edge" : asset === "mines" ? "Flag" : "Mark empty";
---

<section class="tatham-host" data-tatham-host data-tatham-asset={asset} aria-label={`${label} puzzle`}>
  <div class="tatham-touch-modes" aria-label="Touch input mode">
    <span>Touch mode</span>
    <button type="button" data-tatham-mode="primary" aria-pressed="true">{primaryMode}</button>
    <button type="button" data-tatham-mode="mark" aria-pressed="false">{secondaryMode}</button>
  </div>

  <main id="puzzle" style="display:none">
    <form id="gamemenu" class="tatham-toolbar">
      <div class="tatham-presets"><strong>Board</strong><ul id="gametype" aria-label="Board size"></ul></div>
      <div class="tatham-primary-controls">
        <button type="button" id="new">New</button>
        <button type="button" id="restart">Restart</button>
        <button type="button" id="undo">Undo</button>
        <button type="button" id="redo">Redo</button>
      </div>
      <details class="tatham-more">
        <summary>More</summary>
        <div>
          <button type="button" id="specific">Game ID</button>
          <button type="button" id="random">Random seed</button>
          <button type="button" id="save">Save file</button>
          <button type="button" id="load">Load file</button>
          <button type="button" id="prefs">Preferences</button>
          <button type="button" id="solve">Solve</button>
        </div>
      </details>
    </form>
    <div id="puzzlecanvascontain">
      <div id="resizable">
        <canvas id="puzzlecanvas" tabindex="0" aria-label={`${label} interactive puzzle canvas`}></canvas>
        <div id="statusbar" role="status" aria-live="polite"></div>
        <svg id="resizehandle" aria-label="Resize puzzle" width="18" height="18" role="img">
          <title>Drag to resize the puzzle. Right-click to restore its default size.</title>
          <path d="M16,2L2,16M16,8L8,16M16,13L13,16" stroke="currentColor" stroke-linecap="round"></path>
        </svg>
      </div>
    </div>
    <p class="tatham-permalinks">Link to this puzzle: <a id="permalink-desc">game ID</a> · <a id="permalink-seed">random seed</a></p>
  </main>

  <div id="apology" class="tatham-loading" role="status">
    <strong>Loading the puzzle engine…</strong>
    <span>If this stays visible, Boho News could not start the local puzzle engine. Keep your browser security settings on and try one refresh.</span>
  </div>
</section>

<script is:inline defer src={scriptSource}></script>
<script>
  // @ts-nocheck -- Small adapter around the pinned upstream canvas handlers.
  const tathamHost = document.querySelector("[data-tatham-host]");
  if (tathamHost) {
    const canvas = tathamHost.querySelector("#puzzlecanvas");
    const modeButtons = [...tathamHost.querySelectorAll("[data-tatham-mode]")];
    let touchMode = "primary";
    modeButtons.forEach((button) => button.addEventListener("click", () => {
      touchMode = button.dataset.tathamMode;
      modeButtons.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button)));
      canvas?.focus();
    }));

    const installTouchMode = () => {
      if (!canvas?.onmousedown || canvas.dataset.bohoTouchMode === "ready") return false;
      const upstreamMouseDown = canvas.onmousedown;
      canvas.onmousedown = (event) => {
        if (touchMode !== "mark" || event.button !== 0 || event.ctrlKey) return upstreamMouseDown.call(canvas,event);
        const marked = new MouseEvent(event.type,{bubbles:event.bubbles,cancelable:true,view:window,button:event.button,buttons:event.buttons,clientX:event.clientX,clientY:event.clientY,screenX:event.screenX,screenY:event.screenY,ctrlKey:true});
        const result = upstreamMouseDown.call(canvas,marked);
        if (marked.defaultPrevented) event.preventDefault();
        return result;
      };
      canvas.dataset.bohoTouchMode = "ready";
      return true;
    };
    if (!installTouchMode()) {
      const touchModeTimer = window.setInterval(() => { if (installTouchMode()) window.clearInterval(touchModeTimer); },100);
      window.setTimeout(() => window.clearInterval(touchModeTimer),10000);
    }
  }
</script>
