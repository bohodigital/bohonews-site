---
import type { PublicArticle } from "../lib/news";
import { articlePath, formatTimestamp } from "../lib/news";
interface Props { article: PublicArticle; prominent?: boolean; }
const { article, prominent = false } = Astro.props;
---
<article class:list={["story-card", {prominent}]} data-pagefind-filter={`section:${article.section}`} data-pagefind-meta={`article-type:${article.articleType}`}>
  <p class="label">{article.articleType.replaceAll("-", " ")}</p>
  <h2><a href={articlePath(article)}>{article.headline}</a></h2>
  <p class="dek">{article.dek}</p>
  <p class="meta"><time datetime={article.updatedAt}>{formatTimestamp(article.updatedAt)}</time></p>
</article>
