---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<section class:list={["weather-radar", compact && "weather-radar--compact"]} data-weather-radar aria-label="Observed radar and forecast precipitation">
  <div class="weather-radar__stage">
    <div class="weather-radar__map" data-radar-map role="region" aria-label="Interactive NOAA radar and precipitation forecast map"></div>
    <div class="weather-radar__live" aria-live="polite"><span data-radar-state>Loading</span><strong data-radar-age>NOAA MRMS</strong></div>
    <div class="weather-radar__legend" data-radar-legend aria-label="Radar reflectivity legend"><span data-radar-legend-low>Light</span><i></i><span data-radar-legend-high>Intense</span></div>
  </div>
  <div class="weather-radar__modes" role="group" aria-label="Weather map layer">
    <button type="button" data-radar-mode="observed" aria-pressed="true">Live precipitation radar</button>
    <button type="button" data-radar-mode="forecast" aria-pressed="false">Forecast accumulation</button>
  </div>
  <div class="weather-radar__toolbar">
    <button type="button" data-radar-play aria-pressed="false">Play radar</button>
    <label class="weather-radar__timeline"><span>Live radar timeline</span><input data-radar-frame type="range" min="0" max="0" value="0" aria-label="Live precipitation radar frame" /></label>
    <time data-radar-time>Loading NOAA radar…</time>
    <button class="weather-radar__utility" type="button" data-radar-speed aria-label="Change animation speed">1× speed</button>
    <button class="weather-radar__utility" type="button" data-radar-latest>Latest</button>
    <label class="weather-radar__toggle"><input data-radar-alerts type="checkbox" checked /> Warnings</label>
  </div>
  <p class="weather-radar__note" data-radar-note>Live NOAA MRMS precipitation radar is shown by default. Forecast accumulation remains available separately.</p>
</section>

<script>
  import "leaflet/dist/leaflet.css";
  import { initWeatherRadar } from "../scripts/weather-radar";
  document.querySelectorAll<HTMLElement>("[data-weather-radar]").forEach(initWeatherRadar);
</script>
